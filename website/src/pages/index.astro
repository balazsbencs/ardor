---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3D from '../components/Hero3D.astro';
import EffectCatalog from '../components/EffectCatalog.astro';
import SignalFlow from '../components/SignalFlow.astro';
import ScreenFrame from '../components/screens/ScreenFrame.astro';
import PresetScreen from '../components/screens/PresetScreen.astro';
import EditScreen from '../components/screens/EditScreen.astro';
import EqScreen from '../components/screens/EqScreen.astro';
import TunerScreen from '../components/screens/TunerScreen.astro';
import { features } from '../data/features';
import { site } from '../data/site';
import { url } from '../lib/url';

const featureFamilies: Record<string, string> = {
  nam: 'var(--family-amp)',
  cab: 'var(--family-cab)',
  effects: 'var(--family-delay)',
  dualrig: 'var(--family-util)',
  dynamics: 'var(--family-mod)',
  ui: 'var(--accent)',
};
---

<BaseLayout>
  <!-- The direction contract is recorded in BaseLayout so it survives the build. -->

  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-rule" aria-hidden="true">
          <span>OPEN SOURCE / PLAY FIRST</span>
          <span>ARDOR // 001</span>
        </div>
        <h1 id="hero-heading">The rig,<br /><span>under your feet.</span></h1>
        <p class="lead">
          Ardor is an open-source guitar processor for the moment you stop thinking about
          the setup and start playing.
        </p>
        <div class="hero-cta">
          <a class="btn" href={url('/docs/getting-started')}>Start with the build</a>
          <a class="btn btn--ghost" href="#interface">See the interface</a>
        </div>
        <div class="hero-facts" aria-label="Ardor highlights">
          <span><strong>Raspberry Pi</strong><small>standalone rig</small></span>
          <span><strong>4 switches</strong><small>made for the stage</small></span>
          <span><strong>MIT licensed</strong><small>open end to end</small></span>
        </div>
      </div>

      <div class="hero-stage-wrap">
        <Hero3D />
        <div class="hero-stage-rail" aria-hidden="true">
          <span>ENCLOSURE / TOP VIEW</span>
          <span><i></i> LIVE PRESET 2</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section interface-section" id="interface" aria-labelledby="interface-heading">
    <div class="container">
      <div class="showcase-head">
        <div class="showcase-mark" aria-hidden="true">01</div>
        <div>
          <h2 id="interface-heading">See what's live<br />before you touch it.</h2>
          <p>
            The on-pedal interface is a map, not a maze: a running preset gets the lamp,
            modules sit on one clear rail, and every control has a readable place.
          </p>
        </div>
      </div>

      <div class="screens-grid">
        <ScreenFrame label="Preset map" caption="Four tiles mirror the four footswitches.">
          <PresetScreen />
        </ScreenFrame>
        <ScreenFrame label="Signal path" caption="Patch points and module families on one rail.">
          <EditScreen />
        </ScreenFrame>
        <ScreenFrame label="Parametric EQ" caption="A live curve with an engraved control strip.">
          <EqScreen />
        </ScreenFrame>
        <ScreenFrame label="Tuner" caption="A center-zero readout built for a glance.">
          <TunerScreen />
        </ScreenFrame>
      </div>

      <div class="section-link">
        <a href={url('/docs/ui-guide')}>Read the UI &amp; controls guide <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section feature-section" id="features" aria-labelledby="features-heading">
    <div class="container">
      <div class="showcase-head">
        <div class="showcase-mark" aria-hidden="true">02</div>
        <div>
          <h2 id="features-heading">Open enough to build.<br />Focused enough to play.</h2>
          <p>
            Bring the sounds you already trust, shape them into a preset, and keep your
            attention on the song.
          </p>
        </div>
      </div>

      <div class="feature-list">
        {features.map((f, i) => (
          <article class="feature-row" style={`--family:${featureFamilies[f.id] ?? 'var(--accent)'}`}>
            <span class="feature-index mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="feature-kicker mono">{f.kicker}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section chain-section" id="chain" aria-labelledby="chain-heading">
    <div class="container">
      <div class="showcase-head">
        <div class="showcase-mark" aria-hidden="true">03</div>
        <div>
          <h2 id="chain-heading">Make the path obvious.</h2>
          <p>
            Compose the sound left to right, split into two lanes when the rig gets wide,
            and join it back at the output.
          </p>
        </div>
      </div>
      <SignalFlow />
      <div class="section-link">
        <a href={url('/docs/signal-chain')}>See the routing rules <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section effects-section" id="effects" aria-labelledby="effects-heading">
    <div class="container">
      <div class="showcase-head">
        <div class="showcase-mark" aria-hidden="true">04</div>
        <div>
          <h2 id="effects-heading">Sound is the destination.</h2>
          <p>
            Modulation, delay, reverb, amp captures, cabinets, dynamics, and EQ—arranged
            around the way a player thinks about a rig.
          </p>
        </div>
      </div>
      <EffectCatalog compact />
      <div class="section-link">
        <a href={url('/docs/effects')}>Open the effects reference <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section closing-section" aria-labelledby="closing-heading">
    <div class="container">
      <div class="closing-panel">
        <div>
          <p class="closing-label mono">OPEN HARDWARE / OPEN SOFTWARE</p>
          <h2 id="closing-heading">Build the rig that follows you.</h2>
          <p>
            Ardor is {site.license}-licensed from the realtime engine to the touch UI,
            manager, enclosure files, and reproducible firmware image.
          </p>
        </div>
        <div class="closing-actions">
          <a class="btn" href={site.repo} target="_blank" rel="noopener">View on GitHub</a>
          <a class="btn btn--ghost" href={url('/docs/hardware')}>Hardware &amp; build</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--hairline);
    background: var(--ground);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(26rem, 1.1fr);
    gap: clamp(var(--sp-5), 7vw, var(--sp-7));
    align-items: center;
    min-height: min(760px, calc(100vh - 4rem));
    padding-block: clamp(var(--sp-5), 6vw, var(--sp-7));
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-rule,
  .hero-stage-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-rule {
    max-width: 31rem;
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--hairline);
  }

  .hero-rule span:first-child {
    color: var(--accent);
  }

  .hero h1 {
    max-width: 8ch;
    margin-bottom: var(--sp-4);
    color: var(--text-strong);
    font-size: var(--step-5);
    letter-spacing: -0.015em;
  }

  .hero h1 span {
    color: var(--accent);
  }

  .lead {
    max-width: 31rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .hero-cta,
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero-cta {
    margin-top: var(--sp-5);
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    max-width: 35rem;
    margin-top: var(--sp-6);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hairline);
  }

  .hero-facts span {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-facts strong {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-facts small {
    color: var(--muted-2);
    font-size: var(--step--1);
  }

  .hero-stage-wrap {
    min-width: 0;
  }

  .hero-stage-wrap :global(.stage) {
    min-height: 0;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .hero-stage-rail {
    padding-top: var(--sp-2);
    border-top: 1px solid var(--hairline);
  }

  .hero-stage-rail i {
    display: inline-block;
    width: 0.65em;
    height: 0.65em;
    margin-right: 0.45em;
    background: var(--accent);
    vertical-align: -0.02em;
  }

  .hero-stage-rail span:last-child {
    color: var(--accent);
  }

  .showcase-head {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
    max-width: 58rem;
    margin-bottom: var(--sp-5);
  }

  .showcase-mark {
    padding-top: 0.25rem;
    border-top: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }

  .showcase-head h2 {
    margin-bottom: var(--sp-3);
  }

  .showcase-head p {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .screens-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--sp-4), 4vw, var(--sp-5));
  }

  .section-link {
    margin-top: var(--sp-5);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-link a span {
    display: inline-block;
    margin-left: 0.35em;
  }

  .feature-list {
    border-top: 1px solid var(--hairline);
  }

  .feature-row {
    display: grid;
    grid-template-columns: 3rem 5rem minmax(12rem, 0.75fr) minmax(14rem, 1fr);
    gap: var(--sp-3);
    align-items: baseline;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .feature-index,
  .feature-kicker {
    color: var(--muted-2);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }

  .feature-kicker {
    color: var(--family);
  }

  .feature-row h3 {
    margin: 0;
    font-size: var(--step-1);
  }

  .feature-row p {
    margin: 0;
    color: var(--muted);
    line-height: 1.4;
  }

  .chain-section :global(.flow) {
    margin-top: var(--sp-5);
  }

  .closing-panel {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-5);
    align-items: end;
    padding: clamp(var(--sp-4), 5vw, var(--sp-6));
    border: 1px solid var(--hairline-strong);
    background: var(--surface);
  }

  .closing-label {
    margin-bottom: var(--sp-3);
    color: var(--accent);
    font-size: var(--step--1);
    letter-spacing: 0.16em;
  }

  .closing-panel h2 {
    margin-bottom: var(--sp-2);
  }

  .closing-panel p:not(.closing-label) {
    max-width: 40rem;
    margin-bottom: 0;
    color: var(--muted);
  }

  .closing-actions {
    flex: none;
  }

  @media (max-width: 1000px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-stage-wrap {
      max-width: 52rem;
      margin-inline: auto;
    }

    .hero-copy {
      max-width: 42rem;
    }
  }

  @media (max-width: 760px) {
    .screens-grid {
      grid-template-columns: 1fr;
    }

    .feature-row {
      grid-template-columns: 2.5rem 1fr;
      gap: 0.45rem var(--sp-3);
    }

    .feature-row h3,
    .feature-row p {
      grid-column: 2;
    }

    .feature-kicker {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-index {
      grid-row: 1 / span 3;
    }

    .closing-panel {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .hero h1 {
      font-size: clamp(3rem, 17vw, 5rem);
    }

    .hero-facts {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }

    .hero-stage-rail {
      font-size: 0.63rem;
    }
  }
</style>
