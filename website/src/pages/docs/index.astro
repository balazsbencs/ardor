---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsNav } from '../../data/site';
import { url } from '../../lib/url';
---

<DocsLayout
  title="Documentation"
  description="Guides to every feature of the Ardor pedal: signal chain, effects, the touch UI, presets, and hardware."
  lede="Start with a ready-made image, learn the screen, and build your sounds. Use the advanced notes only when you need them."
>
  <div class="doc-cards">
    {docsNav.map((d, i) => (
      <a class="doc-card panel panel--tick" href={url(d.href)}>
        <span class="doc-card-num mono tnum">{String(i + 1).padStart(2, '0')}</span>
        <h3>{d.label}</h3>
        <p>{d.blurb}</p>
        <span class="doc-card-go mono">Open →</span>
      </a>
    ))}
  </div>

  <h2>New here?</h2>
  <p>
    Start with <a href={url('/docs/getting-started')}>Getting Started</a>. It shows you how
    to write a ready-made image to a microSD card, connect the pedal, and make your first
    sound. Then read <a href={url('/docs/ui-guide')}>UI &amp; Controls</a> to learn the
    screen. You can return to the other guides when you want to build sounds, use two rigs,
    or build the hardware.
  </p>

  <style>
    .doc-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
      gap: var(--sp-3);
      margin-bottom: var(--sp-5);
    }
    .doc-card {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: var(--sp-4);
      color: var(--text);
    }
    .doc-card:hover {
      border-color: var(--accent-dim);
      color: var(--text);
    }
    .doc-card h3 {
      margin: 0;
      color: var(--text-strong);
      font-size: var(--step-1);
    }
    .doc-card p {
      margin: 0;
      color: var(--muted);
      font-size: var(--step-0);
    }
    .doc-card-num {
      color: var(--accent);
      font-size: var(--step--1);
    }
    .doc-card-go {
      margin-top: auto;
      padding-top: var(--sp-2);
      color: var(--accent);
      font-size: var(--step--1);
    }
  </style>
</DocsLayout>
