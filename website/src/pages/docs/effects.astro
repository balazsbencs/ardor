---
import DocsLayout from '../../layouts/DocsLayout.astro';
import ParamTable from '../../components/ParamTable.astro';
import { byCategory, describe, counts, effectFamilies } from '../../lib/effects';
import { url } from '../../lib/url';

const rigBlocks = [...byCategory('amp'), ...byCategory('cabinet')];
---

<DocsLayout
  title="Effects Reference"
  description="Every Ardor block, what it does, and the values that its controls accept."
  lede="Open a block on the pedal or in the manager to change its controls. This page tells you what each block does and lists the values that it accepts."
>
  <h2>Amp and cabinet</h2>
  <p>
    These blocks are the core of the rig. Add your own amp captures and impulse responses in the
    <a href={url('/docs/manager')}>manager</a>, then choose them in the block.
  </p>
  <div class="fx-details" style="--cat: var(--family-amp)">
    {rigBlocks.map((def) => (
      <details>
        <summary>
          <span class="sum-name">{def.name}</span>
          <span class="sum-desc">{describe(def)}</span>
        </summary>
        <ParamTable id={def.id} />
      </details>
    ))}
  </div>

  <h2>Effects</h2>
  <p class="lead-in">
    Ardor has {counts.effects} built-in effects in {effectFamilies.length} families. Each family has
    one color, on the pedal and in the manager. Open an effect to see its controls and values.
  </p>

  {effectFamilies.map((family) => (
    <section class="fx-group" style={`--cat:${family.color}`} id={family.key}>
      <h3><span class="swatch" aria-hidden="true"></span>{family.label} <span class="count mono tnum">{family.definitions.length}</span></h3>
      <div class="fx-details">
        {family.definitions.map((def) => (
          <details>
            <summary>
              <span class="sum-name">{def.name}</span>
              <span class="sum-desc">{describe(def)}</span>
            </summary>
            <ParamTable id={def.id} />
          </details>
        ))}
      </div>
    </section>
  ))}

  <p class="trademark">
    Product names such as ProCo RAT, Lovetone Big Cheese, Studer, Whammy, and GCB-95 belong to their
    owners. Ardor uses them only to identify the circuits that its models follow.
  </p>

  <p>
    See how these blocks connect in <a href={url('/docs/signal-chain')}>Signal Chain &amp; Routing</a>.
  </p>

  <style>
    .fx-group {
      margin-bottom: var(--sp-4);
      scroll-margin-top: 5rem;
    }
    .fx-group h3 {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .swatch {
      width: 0.8rem;
      height: 0.8rem;
      background: var(--cat);
    }
    .count {
      color: var(--muted);
      font-size: var(--step-0);
    }
    .fx-details {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-bottom: var(--sp-4);
    }
    details {
      border: 1px solid var(--hairline);
      border-top: 3px solid var(--cat);
      background: linear-gradient(to bottom, color-mix(in srgb, var(--cat) 8%, var(--surface)), var(--surface) 3.5rem);
      padding: 0 var(--sp-3);
    }
    details[open] {
      padding-bottom: var(--sp-2);
    }
    summary {
      cursor: pointer;
      padding: 0.75rem 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.8rem;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary::before {
      content: '+';
      font-family: var(--font-mono);
      color: var(--cat);
      margin-right: 0.2rem;
    }
    details[open] summary::before {
      content: '-';
    }
    .sum-name {
      font-family: var(--font-display);
      font-size: var(--step-1);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-strong);
    }
    .sum-desc {
      flex-basis: 100%;
      color: var(--muted);
      font-size: var(--step-0);
    }
    details table {
      margin-top: 0;
    }
    .trademark {
      margin-top: var(--sp-4);
      color: var(--muted);
      font-size: var(--step--1);
    }
  </style>
</DocsLayout>
