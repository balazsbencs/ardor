---
import DocsLayout from '../../layouts/DocsLayout.astro';
import ParamTable from '../../components/ParamTable.astro';
import { byCategory, describe, counts } from '../../lib/effects';
import { url } from '../../lib/url';

const catGroups = [
  { key: 'modulation', label: 'Modulation', accent: '#59c2e6' },
  { key: 'delay', label: 'Delay', accent: '#3ce0a6' },
  { key: 'reverb', label: 'Reverb', accent: '#c58cff' },
];
---

<DocsLayout
  title="Effects Reference"
  description="Find every Ardor effect, its controls, and its available value ranges."
  lede="Open a block on the pedal or in the manager to change its controls. This page explains what each block does and lists the values that it accepts."
>
  <h2>Amp and cabinet</h2>

  <h3>Amp model</h3>
  <p>
    An amp model changes the guitar signal to sound like an amplifier. Add an amp model from
    your asset library, then use these controls to set its level and input mode.
  </p>
  <ParamTable id="nam" />

  <h3>Cabinet sound</h3>
  <p>
    A cabinet sound shapes the amp model like a speaker cabinet. Choose a cabinet sound and
    set its level or dry/wet mix.
  </p>
  <ParamTable id="cab" />

  <h2>Dynamics &amp; EQ</h2>

  <h3>Compressor</h3>
  <p>A compressor evens out level changes. It includes a detector choice and a dry/wet mix.</p>
  <ParamTable id="dynamics:compressor" />

  <h3>Noise Gate</h3>
  <p>
    A noise gate reduces unwanted noise when you are not playing. It includes hold and
    release controls and does not add extra delay.
  </p>
  <ParamTable id="dynamics:noise_gate" />

  <h3>Five-Band Parametric EQ</h3>
  <p>
    Five adjustable bands change the tone. Each band has frequency, width, and gain controls
    and appears on a live response graph. A saved preset always contains five bands.
  </p>

  <h2>Built-in effects</h2>
  <p class="lead-in">
    Ardor includes {counts.modulation} modulation, {counts.delay} delay, and {counts.reverb}
    reverb effects — <strong>35 effects</strong> in total. Open an effect below to see its
    controls and values.
  </p>

  {catGroups.map((g) => (
    <section class="fx-group" style={`--cat:${g.accent}`}>
      <h3>{g.label} <span class="mono tnum">· {byCategory(g.key).length}</span></h3>
      <div class="fx-details">
        {byCategory(g.key).map((def) => (
          <details>
            <summary>
              <span class="sum-name">{def.name}</span>
              <span class="sum-desc">{describe(def)}</span>
            </summary>
            <ParamTable id={def.id} />
          </details>
        ))}
      </div>
    </section>
  ))}

  <p>
    See how these blocks connect in <a href={url('/docs/signal-chain')}>Signal Chain &amp; Routing</a>.
  </p>

  <style>
    .fx-group {
      margin-bottom: var(--sp-4);
    }
    .fx-group h3 .mono {
      color: var(--cat);
    }
    .fx-details {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    details {
      border: 1px solid var(--hairline);
      border-left: 2px solid var(--cat);
      border-radius: var(--radius);
      background: var(--ground-2);
      padding: 0 var(--sp-3);
    }
    details[open] {
      padding-bottom: var(--sp-2);
    }
    summary {
      cursor: pointer;
      padding: 0.7rem 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.8rem;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary::before {
      content: '+';
      font-family: var(--font-mono);
      color: var(--cat);
      margin-right: 0.4rem;
    }
    details[open] summary::before {
      content: '−';
    }
    .sum-name {
      font-weight: 600;
      color: var(--text-strong);
    }
    .sum-desc {
      color: var(--muted);
      font-size: var(--step--1);
    }
    details table {
      margin-top: 0;
    }
  </style>
</DocsLayout>
