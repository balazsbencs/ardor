---
import { byCategory, describe, counts } from '../lib/effects';

interface Props {
  /** Show the amp/cab/utility building blocks too, or just the 35 FX. */
  full?: boolean;
}
const { full = false } = Astro.props;

const groups = full
  ? [
      { key: 'amp', label: 'Amp', accent: '#ff8a5c' },
      { key: 'cabinet', label: 'Cabinet', accent: '#f5b451' },
      { key: 'utility', label: 'Utility', accent: '#9aa7ff' },
      { key: 'modulation', label: 'Modulation', accent: '#59c2e6' },
      { key: 'delay', label: 'Delay', accent: '#3ce0a6' },
      { key: 'reverb', label: 'Reverb', accent: '#c58cff' },
    ]
  : [
      { key: 'modulation', label: 'Modulation', accent: '#59c2e6' },
      { key: 'delay', label: 'Delay', accent: '#3ce0a6' },
      { key: 'reverb', label: 'Reverb', accent: '#c58cff' },
    ];
---

<div class="catalog">
  {groups.map((g) => {
    const items = byCategory(g.key);
    return (
      <section class="cat" style={`--cat:${g.accent}`}>
        <header class="cat-head">
          <h3>{g.label}</h3>
          <span class="cat-count mono tnum">{String(items.length).padStart(2, '0')}</span>
        </header>
        <ul class="cat-list">
          {items.map((def) => (
            <li class="fx">
              <span class="fx-dot" aria-hidden="true"></span>
              <div class="fx-body">
                <span class="fx-name">{def.name}</span>
                <span class="fx-desc">{describe(def)}</span>
              </div>
              {def.controls.length > 0 && (
                <span class="fx-params mono tnum" title={`${def.controls.length} parameters`}>
                  {def.controls.length}p
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>

{!full && (
  <p class="catalog-total mono">
    {counts.modulation} modulation · {counts.delay} delay · {counts.reverb} reverb
    = <strong>35 effects</strong>, plus amp, cabinet, dynamics, and EQ blocks.
  </p>
)}

<style>
  .catalog {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--sp-4);
  }
  .cat {
    background: linear-gradient(180deg, var(--surface), var(--ground-2));
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--cat);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-3);
  }
  .cat-head h3 {
    margin: 0;
    color: var(--cat);
    font-size: var(--step-1);
  }
  .cat-count {
    font-size: var(--step-1);
    color: var(--muted-2);
  }
  .cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .fx {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-top: 1px solid var(--hairline);
  }
  .fx:first-child {
    border-top: 0;
  }
  .fx-dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--cat);
    transform: translateY(-1px);
  }
  .fx-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .fx-name {
    font-weight: 600;
    color: var(--text-strong);
  }
  .fx-desc {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.45;
  }
  .fx-params {
    font-size: var(--step--1);
    color: var(--muted-2);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 0.05em 0.4em;
    align-self: center;
  }
  .catalog-total {
    margin-top: var(--sp-4);
    text-align: center;
    color: var(--muted);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }
</style>
