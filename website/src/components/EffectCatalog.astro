---
import { byCategory, describe, counts } from '../lib/effects';

interface Props {
  /** Show the amp/cab/utility building blocks too, or just the 35 FX. */
  full?: boolean;
  /** Keep the homepage catalog as a visual sound palette; docs keep the detail. */
  compact?: boolean;
}
const { full = false, compact = false } = Astro.props;

const groups = full
  ? [
      { key: 'amp', label: 'Amp', accent: 'var(--family-amp)' },
      { key: 'cabinet', label: 'Cabinet', accent: 'var(--family-cab)' },
      { key: 'utility', label: 'Utility', accent: 'var(--family-util)' },
      { key: 'modulation', label: 'Modulation', accent: 'var(--family-mod)' },
      { key: 'delay', label: 'Delay', accent: 'var(--family-delay)' },
      { key: 'reverb', label: 'Reverb', accent: 'var(--family-reverb)' },
    ]
  : [
      { key: 'modulation', label: 'Modulation', accent: 'var(--family-mod)' },
      { key: 'delay', label: 'Delay', accent: 'var(--family-delay)' },
      { key: 'reverb', label: 'Reverb', accent: 'var(--family-reverb)' },
    ];
---

<div class:list={['catalog', { compact }]}>
  {groups.map((g) => {
    const items = byCategory(g.key);
    return (
      <section class="cat" style={`--cat:${g.accent}`}>
        <header class="cat-head">
          <h3>{g.label}</h3>
          <span class="cat-count mono tnum">{String(items.length).padStart(2, '0')}</span>
        </header>
        <ul class="cat-list">
          {items.map((def) => (
            <li class="fx">
              <span class="fx-dot" aria-hidden="true"></span>
              <div class="fx-body">
                <span class="fx-name">{def.name}</span>
                {!compact && <span class="fx-desc">{describe(def)}</span>}
              </div>
              {!compact && def.controls.length > 0 && (
                <span class="fx-params mono tnum" title={`${def.controls.length} parameters`}>
                  {def.controls.length}p
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>

{!full && (
  <p class="catalog-total mono">
    {counts.modulation} modulation · {counts.delay} delay · {counts.reverb} reverb
    = <strong>35 effects</strong>, plus amp, cabinet, dynamics, and EQ blocks.
  </p>
)}

<style>
  .catalog {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--sp-4);
  }

  .cat {
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--cat);
    background: var(--surface);
    padding: var(--sp-4);
  }

  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-3);
  }

  .cat-head h3 {
    margin: 0;
    color: var(--cat);
    font-size: var(--step-1);
  }

  .cat-count {
    color: var(--muted-2);
    font-size: var(--step-1);
  }

  .cat-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fx {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.58rem 0;
    border-top: 1px solid var(--hairline);
  }

  .fx:first-child {
    border-top: 0;
  }

  .fx-dot {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--cat);
  }

  .fx-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .fx-name {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .fx-desc {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .fx-params {
    align-self: center;
    padding: 0.05em 0.4em;
    border: 1px solid var(--hairline);
    color: var(--muted-2);
    font-size: var(--step--1);
  }

  .catalog.compact {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .compact .cat {
    padding: var(--sp-3);
  }

  .compact .fx {
    grid-template-columns: auto 1fr;
  }

  .catalog-total {
    margin: var(--sp-4) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-align: center;
  }

  @media (max-width: 860px) {
    .catalog.compact {
      grid-template-columns: 1fr;
    }
  }
</style>
