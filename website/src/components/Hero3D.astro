---
// The hero: an interactive 3D render of the pedal. Falls back to a top-view
// schematic when WebGL is unavailable (the schematic is also the poster shown
// under the canvas while three.js loads).
---

<div class="stage" id="pedal-stage">
  <canvas id="pedal-canvas" aria-hidden="true"></canvas>

  <!-- Schematic fallback / loading poster: real top-view layout of the pedal. -->
  <div class="stage-fallback" id="pedal-fallback">
    <svg viewBox="0 0 360 300" role="img" aria-label="Top view of the Ardor pedal: a touchscreen in the centre, four footswitches in the corners, and an encoder at the rear.">
      <defs>
        <radialGradient id="scr" cx="50%" cy="42%" r="70%">
          <stop offset="0%" stop-color="#123" />
          <stop offset="100%" stop-color="#0a0f11" />
        </radialGradient>
      </defs>
      <rect x="6" y="6" width="348" height="288" rx="18" fill="#12191d" stroke="rgba(120,200,170,0.28)" stroke-width="1.5" />
      <!-- display -->
      <rect x="70" y="66" width="220" height="150" rx="8" fill="url(#scr)" stroke="rgba(120,200,170,0.3)" />
      <rect x="86" y="86" width="80" height="46" rx="5" fill="none" stroke="#3ce0a6" stroke-width="1.5" />
      <rect x="194" y="86" width="80" height="46" rx="5" fill="none" stroke="rgba(120,200,170,0.35)" />
      <rect x="86" y="150" width="80" height="46" rx="5" fill="none" stroke="rgba(120,200,170,0.35)" />
      <rect x="194" y="150" width="80" height="46" rx="5" fill="none" stroke="rgba(120,200,170,0.35)" />
      <!-- footswitches -->
      <circle cx="40" cy="46" r="15" fill="#0a0d0f" stroke="#3a444a" stroke-width="2" />
      <circle cx="320" cy="46" r="15" fill="#0a0d0f" stroke="#3a444a" stroke-width="2" />
      <circle cx="40" cy="254" r="15" fill="#0a0d0f" stroke="#3a444a" stroke-width="2" />
      <circle cx="320" cy="254" r="15" fill="#0a0d0f" stroke="#3a444a" stroke-width="2" />
      <!-- encoder rear-centre -->
      <circle cx="180" cy="40" r="13" fill="#1a2226" stroke="#3a444a" stroke-width="2" />
      <line x1="180" y1="40" x2="180" y2="30" stroke="#3ce0a6" stroke-width="2" />
    </svg>
  </div>

  <div class="stage-hint" id="pedal-hint" aria-hidden="true">
    <span class="mono">DRAG TO ROTATE</span>
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 68vh;
    min-height: 320px;
  }
  /* subtle studio backdrop for depth (not a neon glow) */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 55% at 52% 42%,
      rgba(120, 150, 145, 0.1),
      transparent 70%
    );
    pointer-events: none;
  }
  #pedal-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .stage[data-ready='true'] #pedal-canvas {
    opacity: 1;
  }
  .stage-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--sp-4);
    transition: opacity 0.5s ease;
  }
  .stage-fallback svg {
    width: min(80%, 420px);
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.6));
  }
  .stage[data-ready='true'] .stage-fallback {
    opacity: 0;
    pointer-events: none;
  }
  .stage-hint {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .stage[data-ready='true'] .stage-hint {
    opacity: 0.55;
  }
  .stage-hint .mono {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 0.35em 0.8em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ground) 70%, transparent);
  }
</style>

<script>
  import { initPedal } from '../scripts/pedal3d';

  const stage = document.getElementById('pedal-stage');
  const canvas = document.getElementById('pedal-canvas') as HTMLCanvasElement | null;
  if (stage && canvas) {
    // Defer to idle so the hero text paints first.
    const start = () => {
      const handle = initPedal(canvas);
      if (handle) {
        stage.setAttribute('data-ready', 'true');
      }
      // If init returned null (no WebGL), the schematic fallback stays visible.
    };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(start, { timeout: 800 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>
