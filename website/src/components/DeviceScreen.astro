---
// A real LVGL capture of the pedal screen in a plain black bezel.
// Captures come from `pedal-lvgl-ui-screenshots` (see DESIGN.md).
//
// The glow follows the Glow Rule: it sits behind the red part of the capture,
// so the light has a visible source. `glow="dual"` lights the Dual Rig lanes
// in their own colours instead.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  caption?: string;
  /** Glow centre as percentages of the figure, or 'dual', or false for none. */
  glow?: { x: number; y: number; strength?: 'full' | 'soft' } | 'dual' | false;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  label,
  caption,
  glow = false,
  eager = false,
  sizes = '(max-width: 980px) 100vw, 60vw',
  class: className,
} = Astro.props;

const glowStyle =
  glow && glow !== 'dual'
    ? `--gx:${glow.x}%;--gy:${glow.y}%;--gc:${glow.strength === 'soft' ? 'var(--glow-lamp-soft)' : 'var(--glow-lamp)'}`
    : undefined;
---

<figure
  class:list={['device-screen', className, { 'has-glow': glow && glow !== 'dual', 'glow-dual': glow === 'dual' }]}
  style={glowStyle}
  data-reveal
>
  <div class="bezel">
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
  {(label || caption) && (
    <figcaption>
      {label && <b>{label}</b>}
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .device-screen {
    position: relative;
    isolation: isolate;
    margin: 0;
  }
  .bezel {
    padding: 10px;
    background: var(--bezel);
    box-shadow: var(--shadow-object);
  }
  .bezel :global(img) {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 14px;
    color: var(--muted);
    font-size: var(--step-0);
  }
  figcaption b {
    margin-right: 8px;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* A box centred on the light source; closest-side always fades out before the edge. */
  .has-glow::before,
  .glow-dual::before,
  .glow-dual::after {
    position: absolute;
    top: var(--gy, 40%);
    left: var(--gx, 50%);
    z-index: -1;
    width: 120%;
    aspect-ratio: 1.7;
    background: radial-gradient(closest-side, var(--gc), transparent);
    content: '';
    pointer-events: none;
    transform: translate(-50%, -50%);
  }
  .glow-dual::before {
    --gx: 50%;
    --gy: 30%;
    --gc: color-mix(in srgb, var(--family-util) calc(var(--glow-family) * 1.6), transparent);
  }
  .glow-dual::after {
    --gx: 50%;
    --gy: 72%;
    --gc: color-mix(in srgb, var(--family-amp) calc(var(--glow-family) * 1.3), transparent);
  }
</style>
