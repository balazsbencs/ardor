---
const pre = [
  { name: 'Input', kind: 'guitar in', cat: 'io' },
  { name: 'Noise Gate', kind: 'utility', cat: 'utility' },
  { name: 'Compressor', kind: 'utility', cat: 'utility' },
];
const left = [
  { name: 'NAM Amp', kind: 'amp', cat: 'amp' },
  { name: 'Cabinet IR', kind: 'cab', cat: 'cabinet' },
  { name: 'Tape Delay', kind: 'delay', cat: 'delay' },
];
const right = [
  { name: 'NAM Amp', kind: 'amp', cat: 'amp' },
  { name: 'Cabinet IR', kind: 'cab', cat: 'cabinet' },
  { name: 'Shimmer', kind: 'reverb', cat: 'reverb' },
];
const lanes = [
  { tag: 'LEFT → L', blocks: left },
  { tag: 'RIGHT → R', blocks: right },
];
---

<div class="flow" role="img" aria-label="Signal chain: input, noise gate and compressor feed a split; two parallel lanes run through amp, cabinet and effects blocks; join merges them to the stereo output and limiter.">
  <div class="chain pre">
    {pre.map((b, i) => (
      <>
        {i > 0 && <span class="wire" aria-hidden="true"></span>}
        <div class:list={['node', `c-${b.cat}`]}>
          <span class="k">{b.kind}</span>
          <span class="n">{b.name}</span>
        </div>
      </>
    ))}
  </div>

  <span class="vconn" aria-hidden="true"></span>

  <div class="rig">
    <div class="bus"><span>SPLIT</span></div>
    <div class="lanes">
      {lanes.map((lane) => (
        <div class="lane">
          <span class="lane-tag mono">{lane.tag}</span>
          <div class="chain">
            {lane.blocks.map((b, i) => (
              <>
                {i > 0 && <span class="wire" aria-hidden="true"></span>}
                <div class:list={['node', `c-${b.cat}`]}>
                  <span class="k">{b.kind}</span>
                  <span class="n">{b.name}</span>
                </div>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="bus"><span>JOIN</span></div>
  </div>

  <span class="vconn" aria-hidden="true"></span>

  <div class="chain out-row">
    <div class="node c-io out">
      <span class="k">stereo out</span>
      <span class="n">Output + Limiter</span>
    </div>
  </div>
</div>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: var(--sp-4);
    overflow-x: auto;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .chain {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .node {
    --c: var(--accent);
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.15rem;
    width: 8.4rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--c);
    background: var(--elevated);
  }

  .node .k {
    color: var(--c);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .node .n {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.035em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .out {
    border-color: var(--accent);
  }

  .wire {
    display: block;
    flex: none;
    width: 1.1rem;
    height: 1px;
    background: var(--hairline-strong);
  }

  .vconn {
    display: block;
    width: 1px;
    height: 1.3rem;
    background: var(--hairline-strong);
  }

  .rig {
    width: fit-content;
    min-width: min(100%, 42rem);
  }

  .bus {
    display: grid;
    height: 2.1rem;
    place-items: center;
    border: 1px solid var(--accent-dim);
    background: var(--ground-2);
  }

  .bus span {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .lanes {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-3) 0;
    padding-left: 1.5rem;
    margin-left: 0.75rem;
    border-left: 1px solid var(--hairline-strong);
  }

  .lane {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .lane-tag {
    flex: none;
    width: 5rem;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
  }

  .c-amp { --c: var(--family-amp); }
  .c-cabinet { --c: var(--family-cab); }
  .c-utility { --c: var(--family-util); }
  .c-delay { --c: var(--family-delay); }
  .c-reverb { --c: var(--family-reverb); }
  .c-io { --c: var(--accent); }

  @media (max-width: 620px) {
    .flow {
      align-items: flex-start;
    }

    .lane {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--sp-1);
    }

    .lanes {
      padding-left: 1rem;
    }

    .lane-tag {
      width: auto;
    }
  }
</style>
