---
import './screens.css';

// Mirrors the device preset screen (src/ui/LvglUiPreset.cpp): the live tile
// floods with the lamp, every tile carries its chain as family-coloured block
// codes, and a faulted tile keeps its fault legend on a plain plate.
const slots = [
  { fs: 'FS 1', name: 'Midnight Clean', position: 'tl',
    chain: [['amp', 'TWEED'], ['cab', '1X12'], ['reverb', 'PLATE']] },
  { fs: 'FS 3', name: 'Split Rig / Wide', position: 'tr',
    chain: [['util', 'COMPRESSOR'], ['mod', 'CHORUS'], ['delay', 'TAPE']] },
  { fs: 'FS 2', name: 'Drive Stack', position: 'bl', live: true,
    chain: [['amp', 'RAT'], ['amp', 'PLEXI'], ['cab', '4X12'], ['delay', 'ECHO']] },
  { fs: 'FS 4', name: 'Ambient Bloom', position: 'br', fault: true,
    chain: [['amp', 'TWIN'], ['reverb', 'SHIMMER']] },
];

const masterVolume = 72;
const meterSegments = 16;
const litSegments = Math.round((masterVolume * meterSegments) / 100);
---

<div class="screen preset">
  <div class="scr-head">
    <span class="bank-name">Bank 000 - Set A</span>
    <span class="scr-spacer"></span>
    <span class="scr-meta">Latency 1.33 ms · Buffer 34% used</span>
  </div>

  <div class="preset-grid">
    {slots.map((slot) => (
      <div class:list={['preset-slot', slot.position, { live: slot.live, fault: slot.fault }]}>
        <span class="slot-switch">{slot.fs}{slot.live ? '  ·  Live' : ''}</span>
        <span class="slot-name">{slot.name}</span>
        {slot.fault && <span class="slot-fault">Asset not found</span>}
        <div class="slot-chain" aria-label="Preset chain">
          {slot.chain.map(([family, code]) => <span class={`family-${family}`}>{code}</span>)}
        </div>
      </div>
    ))}
  </div>

  <div class="scr-foot">
    <span class="scr-btn scr-btn--primary">Edit</span>
    <span class="scr-btn">Tuner</span>
    <span class="scr-btn">Looper</span>
    <span class="scr-btn scr-btn--small">Bank −</span>
    <span class="scr-btn scr-btn--small">Bank +</span>
    <span class="scr-btn scr-btn--small">Setup</span>
    <div class="scr-master">
      <span class="scr-foot-label">Master</span>
      <span class="scr-master-value">{masterVolume}</span>
      <span class="scr-meter" aria-hidden="true">
        {Array.from({ length: meterSegments }, (_, segment) => (
          <i class:list={{ on: segment < litSegments }} style={`height:${30 + (segment * 70) / (meterSegments - 1)}%`}></i>
        ))}
      </span>
    </div>
  </div>
</div>

<style>
  .bank-name {
    color: var(--scr-engrave);
    font-size: 2.2cqw;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preset-grid {
    position: absolute;
    top: 7.22%;
    right: 0;
    bottom: 12.22%;
    left: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.1cqw;
    padding: 1.4cqw 2.2cqw;
  }

  .preset-slot {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.4cqw 1.9cqw 1.6cqw;
    border: 0.14cqw solid var(--scr-rule);
    background: var(--scr-plate2);
  }

  /* The only full use of the lamp on screen. */
  .preset-slot.live {
    border-color: var(--scr-live);
    background: var(--scr-live);
    color: var(--scr-plate);
  }

  .preset-slot.fault {
    border-color: var(--scr-fault);
  }

  .slot-switch {
    color: var(--scr-engrave-lo);
    font-size: 1.7cqw;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: pre;
  }

  .live .slot-switch {
    color: var(--scr-plate);
  }

  .slot-name {
    margin-top: 0.8cqw;
    color: var(--scr-engrave);
    font-size: 5.6cqw;
    font-weight: 600;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .live .slot-name {
    color: var(--scr-plate);
  }

  .fault .slot-name {
    color: var(--scr-fault-text);
  }

  .slot-fault {
    align-self: start;
    margin-top: auto;
    margin-bottom: 0.8cqw;
    padding: 0.35cqw 0.8cqw;
    border: 0.14cqw solid var(--scr-fault);
    color: var(--scr-reverb);
    font-size: 1.4cqw;
    font-weight: 500;
    text-transform: uppercase;
  }

  .slot-chain {
    display: flex;
    gap: 0.3cqw;
    margin-top: auto;
  }

  .fault .slot-chain {
    margin-top: 0;
  }

  .slot-chain span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 0.5cqw 0.6cqw;
    color: var(--scr-plate);
    font-size: 1.4cqw;
    font-weight: 500;
    white-space: nowrap;
    background: var(--scr-rule);
  }

  .slot-chain .family-amp { background: var(--scr-amp); }
  .slot-chain .family-cab { background: var(--scr-cab); }
  .slot-chain .family-util { background: var(--scr-util); }
  .slot-chain .family-mod { background: var(--scr-mod); }
  .slot-chain .family-delay { background: var(--scr-delay); }
  .slot-chain .family-reverb { background: var(--scr-reverb); }

  /* On the flooded tile the strip inverts: dark cells, lamp codes. */
  .live .slot-chain span {
    background: var(--scr-plate);
    color: var(--scr-live);
  }
</style>
