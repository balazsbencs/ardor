---
interface Props {
  label?: string;
  caption?: string;
}
const { label, caption } = Astro.props;
---

<figure class="frame">
  <div class="bezel">
    <slot />
  </div>
  {(label || caption) && (
    <figcaption>
      {label && <span class="frame-label mono">{label}</span>}
      {caption && <span class="frame-caption">{caption}</span>}
    </figcaption>
  )}
</figure>

<style>
  .frame {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .bezel {
    padding: 0.65rem;
    border: 1px solid var(--hairline-strong);
    background: #0c0e10;
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.28);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1em;
    align-items: baseline;
  }

  .frame-label {
    color: var(--accent);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .frame-caption {
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
