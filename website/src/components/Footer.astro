---
import { site, docsNav } from '../data/site';
import { url } from '../lib/url';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">{site.name}</span>
      </div>
      <p class="muted">{site.tagline}</p>
      <p class="footer-meta">Open source under the {site.license} license.</p>
    </div>

    <nav class="footer-col" aria-label="Documentation">
      <h4>Documentation</h4>
      <ul>
        {docsNav.slice(0, 5).map((d) => (
          <li><a href={url(d.href)}>{d.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="More">
      <h4>More</h4>
      <ul>
        {docsNav.slice(5).map((d) => (
          <li><a href={url(d.href)}>{d.label}</a></li>
        ))}
        <li><a href={url('/user-manual')}>User manual</a></li>
        <li><a href={site.repo} target="_blank" rel="noopener">Source on GitHub ↗</a></li>
      </ul>
    </nav>
  </div>
  <div class="container">
    <p class="footer-base">Not affiliated with Raspberry Pi Ltd or the Neural Amp Modeler project.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    background: var(--ground);
    padding-block: var(--sp-6) var(--sp-4);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--sp-5);
  }
  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--sp-2);
    color: var(--text-strong);
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
  }
  .brand-mark {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--accent);
  }
  .brand-name {
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }
  .footer-brand p {
    max-width: 34ch;
  }
  .footer-meta {
    color: var(--muted-2);
    font-size: var(--step--1);
  }
  .footer-col h4 {
    margin-bottom: var(--sp-2);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-col a {
    color: var(--text);
    font-size: var(--step-0);
  }
  .footer-col a:hover {
    color: var(--text-strong);
  }
  .footer-base {
    max-width: none;
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hairline);
    color: var(--muted-2);
    font-size: var(--step--1);
  }
  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
