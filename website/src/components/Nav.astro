---
import { primaryNav, site } from '../data/site';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href={url('/')} aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">OPEN RIG</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {primaryNav.map((link) => (
        <a href={link.href.startsWith('/#') ? `${url('/')}${link.href.slice(1)}` : url(link.href)}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <a class="btn btn--ghost nav-github" href={site.repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ground);
    border-bottom: 1px solid var(--hairline);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .brand:hover {
    color: var(--text-strong);
  }
  .brand-mark {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0;
    background: var(--accent);
    align-self: center;
  }
  .brand-name {
    font-size: 1.2rem;
    letter-spacing: 0.02em;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    color: var(--muted-2);
  }
  .nav-links {
    display: flex;
    gap: var(--sp-4);
    margin-left: auto;
  }
  .nav-links a {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav-links a:hover {
    color: var(--text-strong);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 2.4rem;
    height: 2.4rem;
    align-items: center;
    justify-content: center;
    background: var(--elevated);
    border: 1px solid var(--hairline);
    border-radius: 0;
    cursor: pointer;
  }
  .nav-toggle span {
    width: 18px;
    height: 2px;
    background: var(--text);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 820px) {
    .nav-links {
      position: absolute;
      inset: 4rem 0 auto 0;
      flex-direction: column;
      gap: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--hairline);
      padding: var(--sp-2) var(--sp-4);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .nav-links a {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--hairline);
    }
    .site-nav[data-open='true'] .nav-links {
      max-height: 60vh;
    }
    .nav-github span {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const header = toggle?.closest('.site-nav');
  toggle?.addEventListener('click', () => {
    const open = header?.getAttribute('data-open') === 'true';
    header?.setAttribute('data-open', String(!open));
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
