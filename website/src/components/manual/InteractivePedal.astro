</style>

<script>
  type Mode = 'preset' | 'looper' | 'tuner' | 'edit';
  type Context = { title: string; gesture: string; description: string };

  const root = document.querySelector<HTMLElement>('[data-manual-simulator]');

  if (root) {
    const manualRoot = root;
    const pedal = manualRoot.querySelector<HTMLElement>('.pedal-art')!;
    const fsButtons = new Map<number, HTMLButtonElement>(
      [...root.querySelectorAll<HTMLButtonElement>('[data-fs]')].map((button) => [Number(button.dataset.fs), button]),
    );
    const encoder = root.querySelector<HTMLButtonElement>('[data-encoder]')!;
    const progress = root.querySelector<HTMLProgressElement>('[data-hold-progress]')!;
    const progressLabel = root.querySelector<HTMLElement>('[data-hold-label]')!;
    const progressTime = root.querySelector<HTMLElement>('[data-hold-time]')!;
    const liveResult = root.querySelector<HTMLElement>('[data-live-result]')!;
    const contextMode = root.querySelector<HTMLElement>('[data-context-mode]')!;
    const contextTitle = root.querySelector<HTMLElement>('[data-context-title]')!;
    const contextGesture = root.querySelector<HTMLElement>('[data-context-gesture]')!;
    const contextDescription = root.querySelector<HTMLElement>('[data-context-description]')!;
    const eventLog = root.querySelector<HTMLOListElement>('[data-event-log]')!;
    const railMode = root.querySelector<HTMLElement>('[data-rail-mode]')!;

    let mode: Mode = 'preset';
    let returnMode: Mode = 'preset';
    let activePreset = 2;
    let bank = 0;
    let master = 72;
    let selectedTrack = 1;
    let loopRunning = true;
    let lastTakeUndone = false;
    let tunerCents = -6;
    let gestureToken = 0;
    let holdTriggered = false;
    let chordAttempted = false;
    let encoderDragY: number | null = null;
    const held = new Set<number>();
    const tracks = new Map<number, { state: string; muted: boolean }>([
      [1, { state: 'PLAY', muted: false }],
      [2, { state: 'EMPTY', muted: false }],
      [3, { state: 'EMPTY', muted: false }],
      [4, { state: 'EMPTY', muted: false }],
    ]);

    const contexts: Record<string, Context> = {
      combo: { title: 'FS1 + FS2', gesture: 'HOLD 1 SECOND', description: 'Mute the output and open the tuner. Press any footswitch to return.' },
      preset1: { title: 'FS1', gesture: 'PRESS', description: 'Select preset slot 1 in the active bank.' },
      preset2: { title: 'FS2', gesture: 'PRESS', description: 'Select preset slot 2. Hold it for one second when it is active to enter Looper.' },
      preset3: { title: 'FS3', gesture: 'PRESS', description: 'Select preset slot 3 in the active bank.' },
      preset4: { title: 'FS4', gesture: 'PRESS', description: 'Select preset slot 4 in the active bank.' },
      looper1: { title: 'FS1', gesture: 'PRESS', description: 'Undo or redo the latest take on the selected track.' },
      looper2: { title: 'FS2', gesture: 'PRESS / HOLD', description: 'Press to select the next track. Hold for 1.5 seconds to clear the selected track.' },
      looper3: { title: 'FS3', gesture: 'PRESS', description: 'Start or finish the first loop, or arm one synchronized overdub.' },
      looper4: { title: 'FS4', gesture: 'PRESS', description: 'Mute or unmute the selected track without stopping its shared clock.' },
      tuner: { title: 'ANY FS', gesture: 'PRESS', description: 'Leave the tuner without changing the selected preset.' },
      encoder: { title: 'ENCODER', gesture: 'TURN', description: 'Change the master output volume. Scroll, drag vertically, or use the arrow keys.' },
      screen: { title: 'TOUCHSCREEN', gesture: 'TAP', description: 'Open Edit, Tuner, Looper, bank controls, and mode-specific actions directly on the display.' },
    };

    const modeLabel = () => mode === 'edit' ? 'EDIT SCREEN' : `${mode.toUpperCase()} MODE`;

    function setContext(key: string, selected = key) {
      const data = contexts[key] ?? contexts.screen;
      contextMode.textContent = modeLabel();
      contextTitle.textContent = data.title;
      contextGesture.textContent = data.gesture;
      contextDescription.textContent = data.description;
      pedal.dataset.selected = selected;
    }

    function logEvent(label: string, detail: string) {
      if (eventLog.firstElementChild?.querySelector('b')?.textContent === 'READY') eventLog.innerHTML = '';
      const item = document.createElement('li');
      const title = document.createElement('b');
      const note = document.createElement('small');
      title.textContent = label;
      note.textContent = detail;
      item.append(title, note);
      eventLog.prepend(item);
      while (eventLog.children.length > 3) eventLog.lastElementChild?.remove();
    }

    function resetProgress() {
      gestureToken += 1;
      progress.value = 0;
      progressLabel.textContent = 'READY';
      progressTime.textContent = '0.0 s';
    }

    function beginHold(duration: number, label: string, onComplete: () => void) {
      const token = ++gestureToken;
      const started = performance.now();
      progressLabel.textContent = label;
      progress.value = 0;
      holdTriggered = false;

      const frame = (now: number) => {
        if (token !== gestureToken) return;
        const elapsed = Math.min(duration, now - started);
        progress.value = (elapsed / duration) * 100;
        progressTime.textContent = `${(elapsed / 1000).toFixed(1)} s`;
        if (elapsed >= duration) {
          holdTriggered = true;
          onComplete();
          return;
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }

    function finishProgress(label: string) {
      progress.value = 100;
      progressLabel.textContent = label;
      setTimeout(() => {
        if (!held.size) resetProgress();
      }, 650);
    }

    function render() {
      manualRoot.querySelectorAll<HTMLElement>('[data-screen-mode]').forEach((screen) => {
        screen.hidden = screen.dataset.screenMode !== mode;
      });
      manualRoot.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
        button.classList.toggle('active', button.dataset.modeTarget === mode);
      });
      manualRoot.querySelectorAll<HTMLElement>('[data-screen-master]').forEach((item) => item.textContent = String(master));
      manualRoot.querySelector<HTMLElement>('[data-bank-label]')!.textContent = `BANK ${String(bank).padStart(3, '0')} · SET A`;
      manualRoot.querySelectorAll<HTMLButtonElement>('[data-screen-slot]').forEach((tile) => {
        tile.classList.toggle('active', Number(tile.dataset.screenSlot) === activePreset);
      });
      manualRoot.querySelectorAll<HTMLButtonElement>('[data-track]').forEach((tile) => {
        const track = Number(tile.dataset.track);
        const trackData = tracks.get(track)!;
        tile.classList.toggle('selected', track === selectedTrack);
        tile.classList.toggle('recording', trackData.state === 'REC' || trackData.state === 'OVERDUB');
        tile.classList.toggle('muted', trackData.muted);
        manualRoot.querySelector<HTMLElement>(`[data-track-state="${track}"]`)!.textContent = trackData.muted ? 'MUTED' : trackData.state;
      });
      const transport = manualRoot.querySelector<HTMLElement>('[data-loop-transport]');
      if (transport) transport.textContent = loopRunning ? 'RUNNING' : 'PAUSED';
      railMode.textContent = modeLabel();
    }

    function setMode(next: Mode, message?: string) {
      mode = next;
      render();
      if (next === 'tuner') setContext('tuner', 'screen');
      else if (next === 'looper') setContext(`looper${selectedTrack}`, `fs${selectedTrack}`);
      else if (next === 'edit') setContext('screen', 'screen');
      else setContext(`preset${activePreset}`, `fs${activePreset}`);
      if (message) liveResult.textContent = message;
    }

    function selectPreset(slot: number) {
      activePreset = slot;
      setMode('preset', `Preset ${slot} selected`);
      logEvent(`FS${slot}`, `Preset ${slot}`);
    }

    function enterTuner(origin: Mode = mode) {
      returnMode = origin === 'looper' ? 'looper' : 'preset';
      if (origin === 'looper') loopRunning = false;
      setMode('tuner', 'Output muted · tuner open');
      logEvent('FS1 + FS2', 'Tuner open');
      finishProgress('TUNER OPEN');
    }

    function exitTuner() {
      const target = returnMode === 'looper' ? 'looper' : 'preset';
      if (target === 'looper') loopRunning = true;
      setMode(target, target === 'looper' ? 'Looper restored' : `Preset ${activePreset} unchanged`);
      logEvent('TUNER EXIT', `Return to ${target}`);
    }

    function enterLooper() {
      setMode('looper', `Looper opened with preset ${activePreset} locked`);
      logEvent(`HOLD FS${activePreset}`, 'Looper open');
      finishProgress('LOOPER OPEN');
    }

    function looperFsAction(fs: number, onRelease = false) {
      const track = tracks.get(selectedTrack)!;
      if (fs === 1 && onRelease) {
        if (track.state === 'EMPTY') {
          liveResult.textContent = `Track ${selectedTrack} has no take to undo`;
        } else {
          lastTakeUndone = !lastTakeUndone;
          track.state = lastTakeUndone ? 'UNDONE' : 'PLAY';
          liveResult.textContent = `${lastTakeUndone ? 'Undid' : 'Restored'} Track ${selectedTrack}'s latest take`;
        }
        logEvent('FS1', lastTakeUndone ? 'Undo' : 'Redo');
      }
      if (fs === 2 && onRelease) {
        selectedTrack = selectedTrack === 4 ? 1 : selectedTrack + 1;
        liveResult.textContent = `Track ${selectedTrack} selected`;
        logEvent('FS2', `Track ${selectedTrack}`);
      }
      if (fs === 3 && !onRelease) {
        if (track.state === 'EMPTY') track.state = 'REC';
        else if (track.state === 'REC') track.state = 'PLAY';
        else track.state = 'OVERDUB';
        liveResult.textContent = `Track ${selectedTrack}: ${track.state}`;
        logEvent('FS3', track.state);
      }
      if (fs === 4 && !onRelease) {
        track.muted = !track.muted;
        liveResult.textContent = `Track ${selectedTrack} ${track.muted ? 'muted' : 'playing'}`;
        logEvent('FS4', track.muted ? 'Mute' : 'Play');
      }
      render();
      setContext(`looper${fs}`, `fs${fs}`);
    }

    function clearSelectedTrack() {
      const track = tracks.get(selectedTrack)!;
      track.state = 'EMPTY';
      track.muted = false;
      liveResult.textContent = `Track ${selectedTrack} cleared`;
      logEvent('HOLD FS2', `Clear Track ${selectedTrack}`);
      render();
      finishProgress('TRACK CLEARED');
    }

    function pressSwitch(fs: number) {
      const button = fsButtons.get(fs)!;
      if (held.has(fs)) return;
      held.add(fs);
      button.classList.add('is-pressed');
      holdTriggered = false;

      if (mode === 'tuner') {
        setContext('tuner', `fs${fs}`);
        liveResult.textContent = `FS${fs} pressed · exiting tuner`;
        setTimeout(exitTuner, 180);
        return;
      }

      if (held.has(1) && held.has(2)) {
        chordAttempted = true;
        setContext('combo', 'combo');
        liveResult.textContent = 'FS1 + FS2 detected · keep holding';
        beginHold(1000, 'HOLD FOR TUNER', () => enterTuner(mode));
        return;
      }

      chordAttempted = false;
      const key = mode === 'looper' ? `looper${fs}` : `preset${fs}`;
      setContext(key, `fs${fs}`);
      liveResult.textContent = `FS${fs} down`;

      if (mode === 'preset' && fs === activePreset) {
        beginHold(1000, `HOLD FS${fs} FOR LOOPER`, enterLooper);
      } else if (mode === 'looper' && fs === 2) {
        beginHold(1500, 'HOLD FS2 TO CLEAR', clearSelectedTrack);
      } else if (mode === 'looper' && (fs === 3 || fs === 4)) {
        looperFsAction(fs, false);
      }
    }

    function releaseSwitch(fs: number) {
      const wasHeld = held.delete(fs);
      fsButtons.get(fs)?.classList.remove('is-pressed');
      if (!wasHeld) return;
      const completed = holdTriggered;

      if (mode !== 'tuner' && chordAttempted) {
        if (!completed) {
          liveResult.textContent = 'Chord released early · no action';
          logEvent('FS1 + FS2', 'Released early');
          resetProgress();
        }
        if (!held.size) chordAttempted = false;
        return;
      }

      if (completed) {
        if (!held.size) resetProgress();
        return;
      }

      resetProgress();
      if (mode === 'preset') selectPreset(fs);
      else if (mode === 'looper' && (fs === 1 || fs === 2)) looperFsAction(fs, true);
    }

    function setMaster(next: number, delta: number) {
      master = Math.max(0, Math.min(100, next));
      render();
      encoder.classList.add('is-active', 'is-turning');
      setContext('encoder', 'encoder');
      contextDescription.textContent = `Master output ${master}. Scroll, drag vertically, or use the arrow keys.`;
      liveResult.textContent = `Master output ${master}`;
      logEvent(`ENCODER ${delta > 0 ? '+' : '−'}${Math.abs(delta)}`, `Master ${master}`);
      setTimeout(() => encoder.classList.remove('is-turning'), 170);
    }

    fsButtons.forEach((button, fs) => {
      button.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        button.setPointerCapture(event.pointerId);
        pressSwitch(fs);
      });
      button.addEventListener('pointerup', (event) => {
        if (button.hasPointerCapture(event.pointerId)) button.releasePointerCapture(event.pointerId);
        releaseSwitch(fs);
      });
      button.addEventListener('pointercancel', () => releaseSwitch(fs));
      button.addEventListener('lostpointercapture', () => {
        if (held.has(fs)) releaseSwitch(fs);
      });
    });

    encoder.addEventListener('wheel', (event) => {
      event.preventDefault();
      const delta = event.deltaY < 0 ? 1 : -1;
      setMaster(master + delta, delta);
    }, { passive: false });
    encoder.addEventListener('click', () => setMaster(master + 1, 1));
    encoder.addEventListener('pointerdown', (event) => {
      encoderDragY = event.clientY;
      encoder.setPointerCapture(event.pointerId);
      setContext('encoder', 'encoder');
    });
    encoder.addEventListener('pointermove', (event) => {
      if (encoderDragY === null) return;
      const movement = encoderDragY - event.clientY;
      if (Math.abs(movement) >= 8) {
        const delta = movement > 0 ? 1 : -1;
        encoderDragY = event.clientY;
        setMaster(master + delta, delta);
      }
    });
    encoder.addEventListener('pointerup', () => { encoderDragY = null; });
    encoder.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
        event.preventDefault(); setMaster(master + 1, 1);
      }
      if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
        event.preventDefault(); setMaster(master - 1, -1);
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-screen-slot]').forEach((button) => {
      button.addEventListener('click', () => selectPreset(Number(button.dataset.screenSlot)));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-track]').forEach((button) => {
      button.addEventListener('click', () => {
        selectedTrack = Number(button.dataset.track);
        render();
        liveResult.textContent = `Track ${selectedTrack} selected on touchscreen`;
        setContext('screen', 'screen');
        logEvent('TOUCH', `Track ${selectedTrack}`);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-touch-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.touchAction;
        setContext('screen', 'screen');
        if (action === 'edit') setMode('edit', 'Signal chain editor open');
        if (action === 'tuner') { returnMode = 'preset'; setMode('tuner', 'Output muted · tuner opened by touch'); }
        if (action === 'looper') enterLooper();
        if (action === 'bank-down') { bank = Math.max(0, bank - 1); render(); liveResult.textContent = `Bank ${String(bank).padStart(3, '0')}`; }
        if (action === 'bank-up') { bank += 1; render(); liveResult.textContent = `Bank ${String(bank).padStart(3, '0')}`; }
        if (action === 'tuner-exit') exitTuner();
        if (action === 'tuner-pitch') {
          tunerCents = tunerCents >= 8 ? -9 : tunerCents + 3;
          root.querySelector<HTMLElement>('[data-tuner-cents]')!.textContent = `${tunerCents >= 0 ? '+' : '−'}${Math.abs(tunerCents).toFixed(1)}`;
          root.querySelector<HTMLElement>('[data-tuner-needle]')!.style.left = `${50 + tunerCents * 0.7}%`;
          root.querySelector<HTMLElement>('[data-tuner-guidance]')!.textContent = Math.abs(tunerCents) <= 2 ? 'IN TUNE' : tunerCents < 0 ? 'FLAT · TUNE UP' : 'SHARP · TUNE DOWN';
          liveResult.textContent = `Tuner input ${tunerCents >= 0 ? '+' : ''}${tunerCents.toFixed(1)} cents`;
        }
        if (action === 'loop-pause') { loopRunning = !loopRunning; render(); liveResult.textContent = loopRunning ? 'All tracks resumed' : 'All tracks paused'; }
        if (action === 'loop-new') { tracks.forEach((track) => { track.state = 'EMPTY'; track.muted = false; }); render(); liveResult.textContent = 'New empty loop session'; }
        if (action === 'loop-exit') setMode('preset', 'Loop session paused · preset navigation restored');
        if (action === 'edit-exit') setMode('preset', 'Returned to preset screen');
        if (action === 'edit-block') liveResult.textContent = 'Amp controls selected';
        if (action) logEvent('TOUCH', action.replaceAll('-', ' ').toUpperCase());
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.modeTarget as Mode;
        if (target === 'tuner') returnMode = mode === 'looper' ? 'looper' : 'preset';
        setMode(target, `${target[0].toUpperCase()}${target.slice(1)} mode preview`);
        logEvent('MODE', target.toUpperCase());
      });
    });

    window.addEventListener('ardor:open-looper', () => {
      setMode('looper', `Looper opened with preset ${activePreset} locked`);
      logEvent('GUIDE', 'Looper practice');
    });

    function simulateHold(buttons: number[], duration: number, label: string, complete: () => void) {
      if (held.size) return;
      buttons.forEach((fs) => {
        held.add(fs);
        fsButtons.get(fs)?.classList.add('is-pressed');
      });
      if (buttons.length === 2) {
        chordAttempted = true;
        setContext('combo', 'combo');
      }
      liveResult.textContent = `${buttons.map((fs) => `FS${fs}`).join(' + ')} held`;
      beginHold(duration, label, () => {
        complete();
        setTimeout(() => {
          buttons.forEach((fs) => fsButtons.get(fs)?.classList.remove('is-pressed'));
          held.clear();
          chordAttempted = false;
          resetProgress();
        }, 450);
      });
    }

    root.querySelector<HTMLButtonElement>('[data-demo-combo]')!.addEventListener('click', () => {
      simulateHold([1, 2], 1000, 'HOLD FOR TUNER', () => enterTuner(mode));
    });
    root.querySelector<HTMLButtonElement>('[data-demo-looper]')!.addEventListener('click', () => {
      if (mode !== 'preset') setMode('preset');
      simulateHold([activePreset], 1000, `HOLD FS${activePreset} FOR LOOPER`, enterLooper);
    });

    const keyboardHeld = new Set<number>();
    document.addEventListener('keydown', (event) => {
      if (event.repeat || event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      const fs = Number(event.key);
      if (fs >= 1 && fs <= 4 && !keyboardHeld.has(fs)) {
        event.preventDefault();
        keyboardHeld.add(fs);
        pressSwitch(fs);
      }
    });
    document.addEventListener('keyup', (event) => {
      const fs = Number(event.key);
      if (keyboardHeld.delete(fs)) {
        event.preventDefault();
        releaseSwitch(fs);
      }
    });

    render();
    setContext('combo', 'combo');
  }
</script>
