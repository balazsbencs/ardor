---
import { url } from '../../lib/url';

// Tiles follow the real Lamp Black preset screen: FS label, name, and the
// chain as a strip of family colours. Order 1/3 above 2/4 mirrors the switches.
const presets = [
  { slot: 1, name: 'Midnight Clean', chain: [['CMP', 'util'], ['TWIN', 'amp'], ['1X12', 'cab'], ['PLATE', 'reverb']] },
  { slot: 3, name: 'Split Rig / Wide', chain: [['RIG', 'amp'], ['CHO', 'mod'], ['DLY', 'delay']] },
  { slot: 2, name: 'Drive Stack', chain: [['RAT', 'amp'], ['PLEXI', 'amp'], ['4X12', 'cab'], ['ECHO', 'delay']] },
  { slot: 4, name: 'Ambient Bloom', chain: [['TWIN', 'amp'], ['SHIM', 'reverb'], ['BLOOM', 'reverb']] },
];
---

<section class="manual-simulator" data-manual-simulator aria-labelledby="manual-title">
  <h1 id="manual-title" class="visually-hidden">Ardor interactive user manual</h1>

  <div class="manual-workspace">
    <div class="device-field">
      <div class="field-rail" aria-hidden="true">
        <span>TRY THE PEDAL</span>
        <span><i></i><b data-rail-mode>PRESET MODE</b></span>
      </div>

      <div class="pedal-art" data-selected="combo">
        <img
          src={url('/ardor-pedal-manual.webp')}
          alt="Ardor pedal with four corner footswitches, a central touchscreen, and a top-panel rotary encoder."
          width="1536"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <svg class="control-leaders" viewBox="0 0 1536 1024" aria-hidden="true">
          <path data-line="fs1" d="M286 292 L286 145 L1305 145 L1536 220"></path>
          <path data-line="fs2" d="M286 734 L286 835 L1305 835 L1536 724"></path>
          <path data-line="fs3" d="M1245 292 L1370 220 L1536 220"></path>
          <path data-line="fs4" d="M1245 734 L1370 724 L1536 724"></path>
          <path data-line="encoder" d="M768 148 L768 100 L1305 100 L1536 175"></path>
          <path data-line="screen" d="M1080 510 L1370 510 L1536 510"></path>
          <path data-line="combo" d="M286 292 L286 145 L1305 145 L1536 220 M286 734 L286 835 L1305 835 L1536 724"></path>
        </svg>

        <div class="device-screen" data-device-screen aria-live="polite">
          <div class="screen-mode screen-mode--preset" data-screen-mode="preset">
            <div class="screen-head">
              <b>ARDOR</b>
              <span data-bank-label>BANK 000 · SET A</span>
              <span>48 kHz · BLK 64</span>
            </div>
            <div class="preset-map">
              {presets.map((preset) => (
                <button type="button" class="preset-tile" data-screen-slot={preset.slot}>
                  <small>FS {preset.slot}<em>LIVE</em></small>
                  <b>{preset.name}</b>
                  <span class="tile-chain" aria-hidden="true">
                    {preset.chain.map(([code, family]) => <i class={`fam-${family}`}>{code}</i>)}
                  </span>
                </button>
              ))}
            </div>
            <div class="screen-actions">
              <button type="button" data-touch-action="edit">EDIT</button>
              <button type="button" data-touch-action="tuner">TUNER</button>
              <button type="button" data-touch-action="looper">LOOPER</button>
              <button type="button" data-touch-action="bank-down">BANK −</button>
              <button type="button" data-touch-action="bank-up">BANK +</button>
              <span>MASTER <b data-screen-master>72</b></span>
            </div>
          </div>

          <div class="screen-mode screen-mode--tuner" data-screen-mode="tuner" hidden>
            <div class="screen-head">
              <b>TUNER</b><span>CHROMATIC · A4 = 440.0</span><em>OUTPUT MUTED</em>
            </div>
            <div class="tuner-readout">
              <strong>A<sup>2</sup></strong>
              <span>110.42 Hz · <b data-tuner-cents>−6.0</b> cents</span>
              <div class="tuner-rule"><i data-tuner-needle></i></div>
              <small data-tuner-guidance>FLAT · TUNE UP</small>
            </div>
            <div class="screen-actions screen-actions--tuner">
              <span>ANY FOOTSWITCH EXITS</span>
              <button type="button" data-touch-action="tuner-pitch">PLAY NOTE</button>
              <button type="button" data-touch-action="tuner-exit">EXIT</button>
            </div>
          </div>

          <div class="screen-mode screen-mode--looper" data-screen-mode="looper" hidden>
            <div class="screen-head">
              <b>LOOPER</b><span>DRIVE STACK · PRESET LOCKED</span><em data-loop-transport>RUNNING</em>
            </div>
            <div class="track-map">
              {[1, 3, 2, 4].map((track) => (
                <button type="button" data-track={track}>
                  <small>TRACK {track}</small>
                  <b data-track-state={track}>{track === 1 ? 'PLAY' : 'EMPTY'}</b>
                  <i aria-hidden="true"></i>
                </button>
              ))}
            </div>
            <div class="looper-legends">
              <span>FS1 UNDO</span><span>FS3 REC / DUB</span>
              <span>FS2 TRACK / CLEAR</span><span>FS4 PLAY / MUTE</span>
            </div>
            <div class="screen-actions">
              <button type="button" data-touch-action="loop-pause">STOP ALL</button>
              <button type="button" data-touch-action="loop-new">NEW</button>
              <button type="button" data-touch-action="loop-exit">EXIT</button>
              <span>MASTER <b data-screen-master>72</b></span>
            </div>
          </div>

          <div class="screen-mode screen-mode--edit" data-screen-mode="edit" hidden>
            <div class="screen-head"><b>EDIT</b><span>DRIVE STACK</span><em>UNSAVED</em></div>
            <div class="chain-map" aria-label="Illustrative signal chain">
              <span>IN</span><i></i><b>GATE</b><i></i><b>AMP</b><i></i><b>CAB</b><i></i><b>DELAY</b><i></i><span>OUT</span>
            </div>
            <div class="screen-actions">
              <button type="button" data-touch-action="edit-exit">BACK</button>
              <button type="button" data-touch-action="edit-block">OPEN AMP</button>
              <span>TURN ENCODER FOR MASTER</span>
            </div>
          </div>
        </div>

        <button type="button" class="hardware-control footswitch fs1" data-fs="1" aria-label="Footswitch 1">
          <span>FS1</span>
        </button>
        <button type="button" class="hardware-control footswitch fs2" data-fs="2" aria-label="Footswitch 2">
          <span>FS2</span>
        </button>
        <button type="button" class="hardware-control footswitch fs3" data-fs="3" aria-label="Footswitch 3">
          <span>FS3</span>
        </button>
        <button type="button" class="hardware-control footswitch fs4" data-fs="4" aria-label="Footswitch 4">
          <span>FS4</span>
        </button>
        <button
          type="button"
          class="hardware-control encoder-control"
          data-encoder
          aria-label="Master output encoder. Use the mouse wheel, drag, or arrow keys."
        >
          <span>ENCODER</span>
        </button>
      </div>

      <div class="live-strip" aria-live="polite">
        <div class="hold-meter">
          <span data-hold-label>READY</span>
          <progress data-hold-progress max="100" value="0">0%</progress>
          <strong data-hold-time>0.0 s</strong>
        </div>
        <div class="input-state">
          <svg viewBox="0 0 80 28" aria-hidden="true"><path d="M2 14 C10 14 11 3 20 3 S30 25 40 25 50 3 60 3 69 14 78 14"></path></svg>
          <span data-live-result>Choose a control to begin</span>
        </div>
      </div>
    </div>

    <aside class="context-manual" aria-labelledby="context-title">
      <div class="mode-switcher" aria-label="Preview a pedal mode">
        <button type="button" class="active" data-mode-target="preset">PRESET</button>
        <button type="button" data-mode-target="looper">LOOPER</button>
        <button type="button" data-mode-target="tuner">TUNER</button>
      </div>

      <div class="context-copy">
        <span class="mode-name" data-context-mode>PRESET MODE</span>
        <h2 id="context-title" data-context-title>FS1 + FS2</h2>
        <strong data-context-gesture>HOLD 1 SECOND</strong>
        <p data-context-description>Mute the output and open the tuner. Press any footswitch to return.</p>
      </div>

      <div class="gesture-visual" data-gesture-visual>
        <div><i></i><span>FS1</span></div>
        <b>+</b>
        <div><i></i><span>FS2</span></div>
      </div>

      <div class="try-actions">
        <button type="button" data-demo-combo>TRY FS1 + FS2</button>
        <button type="button" data-demo-looper>HOLD ACTIVE PRESET</button>
      </div>

      <div class="context-note">
        <span>PHYSICAL INPUT</span>
        <p>Click a switch, hold a number key, or use multi-touch. Hold <kbd>1</kbd> + <kbd>2</kbd> together for the tuner.</p>
        <a href="#looper-guide">Read the beginner Looper guide</a>
      </div>

      <div class="event-log" aria-label="Recent simulated inputs">
        <span>RECENT INPUTS</span>
        <ol data-event-log>
          <li><b>READY</b><small>Waiting for input</small></li>
        </ol>
      </div>
    </aside>
  </div>

  <section class="control-reference" aria-labelledby="reference-title">
    <header>
      <h2 id="reference-title">Every control, in context.</h2>
      <p>The same four switches change roles in Looper mode. Tuner keeps one simple escape rule: any switch exits.</p>
    </header>

    <div class="reference-table-wrap">
      <table>
        <thead>
          <tr><th>Control</th><th>Preset mode</th><th>Looper mode</th><th>Tuner</th></tr>
        </thead>
        <tbody>
          <tr><th>FS1</th><td>Select preset 1</td><td>Undo / redo selected track</td><td>Exit tuner</td></tr>
          <tr><th>FS2</th><td>Select preset 2</td><td>Next track; hold 1.5 s to clear</td><td>Exit tuner</td></tr>
          <tr><th>FS3</th><td>Select preset 3</td><td>Record / finish / overdub</td><td>Exit tuner</td></tr>
          <tr><th>FS4</th><td>Select preset 4</td><td>Play / mute selected track</td><td>Exit tuner</td></tr>
          <tr><th>FS1 + FS2</th><td>Hold 1 s: open tuner</td><td>Hold 1 s: pause and open tuner</td><td>Not used</td></tr>
          <tr><th>Active preset</th><td>Hold 1 s: enter Looper</td><td>Preset remains locked</td><td>Not used</td></tr>
          <tr><th>Encoder</th><td>Master output volume</td><td>Master output volume</td><td>Master output volume</td></tr>
          <tr><th>Touchscreen</th><td>Bank, Edit, Tuner, Looper, Setup</td><td>Tracks, transport, save/load and exit</td><td>Exit</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</section>

<style>
  .manual-simulator {
    /* The manual page follows the site theme; only the pedal screen keeps device colours. */
    --manual-ground: var(--ground);
    --manual-ground-2: var(--ground-2);
    --manual-plate: var(--surface);
    --manual-raised: var(--elevated);
    --manual-rule: var(--hairline);
    --manual-rule-strong: var(--hairline-strong);
    --manual-text: var(--text-strong);
    --manual-muted: var(--muted);
    --manual-red: var(--accent);
    min-height: 100vh;
    background: var(--manual-ground);
    color: var(--manual-text);
  }

  .manual-workspace {
    display: grid;
    grid-template-columns: minmax(0, 72%) minmax(19rem, 28%);
    min-height: calc(100svh - 4rem);
    border-bottom: 1px solid var(--manual-rule);
  }

  .device-field {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-width: 0;
    overflow: hidden;
    border-right: 1px solid var(--manual-rule);
  }

  .field-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.7rem;
    padding: 0 var(--sp-4);
    border-bottom: 1px solid var(--manual-rule);
    color: var(--manual-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .field-rail > span:last-child {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .field-rail i {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--manual-red);
  }

  .field-rail b {
    color: var(--manual-text);
    font-weight: 500;
  }

  .pedal-art {
    position: relative;
    align-self: center;
    width: min(100%, 70rem);
    margin: auto;
    isolation: isolate;
    user-select: none;
    touch-action: none;
  }

  .pedal-art > img {
    position: relative;
    z-index: 0;
    width: 100%;
  }

  .control-leaders {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .control-leaders path {
    fill: none;
    stroke: var(--manual-red);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .pedal-art[data-selected='fs1'] [data-line='fs1'],
  .pedal-art[data-selected='fs2'] [data-line='fs2'],
  .pedal-art[data-selected='fs3'] [data-line='fs3'],
  .pedal-art[data-selected='fs4'] [data-line='fs4'],
  .pedal-art[data-selected='encoder'] [data-line='encoder'],
  .pedal-art[data-selected='screen'] [data-line='screen'],
  .pedal-art[data-selected='combo'] [data-line='combo'] {
    opacity: 1;
  }

  .hardware-control {
    position: absolute;
    z-index: 7;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--manual-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .footswitch {
    width: 13%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .footswitch::before {
    position: absolute;
    inset: 13%;
    border: 2px solid transparent;
    border-radius: 50%;
    content: '';
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 90ms ease;
  }

  .footswitch:hover::before,
  .footswitch:focus-visible::before {
    border-color: var(--manual-text);
  }

  .footswitch.is-pressed::before {
    border-color: var(--manual-red);
    box-shadow: 0 5px 12px rgba(216, 66, 47, 0.28);
    transform: scale(0.9);
  }

  .footswitch span,
  .encoder-control span {
    position: absolute;
    left: 50%;
    bottom: -0.45rem;
    padding: 0.15rem 0.4rem;
    transform: translateX(-50%);
    background: rgba(17, 20, 22, 0.92);
    color: var(--manual-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.46rem, 0.72vw, 0.68rem);
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .fs1 { left: 18.7%; top: 28.6%; }
  .fs2 { left: 18.7%; top: 72.3%; }
  .fs3 { left: 81.2%; top: 28.6%; }
  .fs4 { left: 81.2%; top: 72.3%; }

  .encoder-control {
    left: 45.5%;
    top: 8.5%;
    width: 9%;
    aspect-ratio: 1.05;
    border-radius: 50%;
  }

  .encoder-control::before {
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    content: '';
    transition: border-color 140ms ease, transform 160ms ease;
  }

  .encoder-control:hover::before,
  .encoder-control:focus-visible::before,
  .encoder-control.is-active::before {
    border-color: var(--manual-red);
  }

  .encoder-control.is-turning::before {
    transform: rotate(28deg) scale(0.92);
  }

  /* The pedal screen always shows the device palette (Lamp Black), in both site themes. */
  .device-screen {
    --lb-ground: #0b0c0d;
    --lb-plate: #16181a;
    --lb-raised: #1d2023;
    --lb-rule: #2b2f33;
    --lb-bone: #eceeed;
    --lb-secondary: #9aa1a6;
    --lb-disabled: #5c6368;
    --lb-lamp: #e8472f;
    --lb-lamp-ink: #1a0906;
    --lb-warning: #e0a53c;
    --lb-amp: #d2923f;
    --lb-cab: #aab2b7;
    --lb-util: #5f95c9;
    --lb-mod: #3fb08c;
    --lb-delay: #9a82d6;
    --lb-reverb: #d07a5a;

    container-type: inline-size;
    position: absolute;
    top: 34.55%;
    left: 28.9%;
    z-index: 4;
    width: 41.5%;
    height: 33.2%;
    overflow: hidden;
    background: var(--lb-ground);
    color: var(--lb-bone);
    font-family: var(--font-display);
    touch-action: manipulation;
  }

  .screen-mode {
    position: absolute;
    inset: 0;
    background: var(--lb-ground);
  }

  .screen-head {
    display: flex;
    align-items: center;
    gap: 1.8cqw;
    height: 14%;
    padding: 0 2.5cqw;
    border-bottom: 0.2cqw solid var(--lb-rule);
    color: var(--lb-secondary);
    font-size: 1.9cqw;
    font-weight: 600;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .screen-head b {
    color: var(--lb-bone);
    font-size: 2.4cqw;
    font-weight: 800;
  }

  .screen-head span:nth-child(2) {
    flex: 1;
  }

  .screen-head em {
    padding: 0.5cqw 1cqw;
    background: var(--lb-warning);
    color: var(--lb-ground);
    font-style: normal;
    font-weight: 700;
  }

  .preset-map,
  .track-map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.3cqw;
    height: 66%;
    padding: 1.9cqw;
  }

  .preset-tile,
  .track-map button {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.3cqw 1.9cqw 1.5cqw;
    border: 0.2cqw solid var(--lb-rule);
    border-radius: 0;
    background: var(--lb-plate);
    color: var(--lb-bone);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .preset-tile small,
  .track-map small {
    display: flex;
    justify-content: space-between;
    color: var(--lb-secondary);
    font-size: 1.5cqw;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .preset-tile small em {
    padding: 0.3cqw 0.8cqw;
    background: var(--lb-lamp-ink);
    color: var(--lb-lamp);
    font-style: normal;
    visibility: hidden;
  }

  .preset-tile > b {
    font-size: 3.6cqw;
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .tile-chain {
    display: flex;
    gap: 0.4cqw;
  }

  .tile-chain i {
    flex: 1;
    padding: 0.35cqw 0.6cqw;
    background: var(--c);
    color: rgba(11, 12, 13, 0.75);
    font-family: var(--font-mono);
    font-size: 0.95cqw;
    font-style: normal;
    letter-spacing: 0.08em;
  }

  .fam-amp { --c: var(--lb-amp); }
  .fam-cab { --c: var(--lb-cab); }
  .fam-util { --c: var(--lb-util); }
  .fam-mod { --c: var(--lb-mod); }
  .fam-delay { --c: var(--lb-delay); }
  .fam-reverb { --c: var(--lb-reverb); }

  /* The live preset is the only flooded tile: the One Lamp Rule. */
  .preset-tile.active {
    border-color: var(--lb-lamp);
    background: var(--lb-lamp);
    color: var(--lb-lamp-ink);
  }

  .preset-tile.active small {
    color: var(--lb-lamp-ink);
  }

  .preset-tile.active small em {
    visibility: visible;
  }

  .preset-tile.active .tile-chain i {
    background: var(--lb-lamp-ink);
    color: var(--lb-lamp);
  }

  .screen-actions {
    display: flex;
    align-items: center;
    gap: 1cqw;
    height: 20%;
    padding: 0 1.9cqw;
    border-top: 0.2cqw solid var(--lb-rule);
  }

  .screen-actions button {
    min-height: 6.3cqw;
    padding: 0 1.4cqw;
    border: 0.2cqw solid var(--lb-rule);
    border-radius: 0;
    background: var(--lb-plate);
    color: var(--lb-bone);
    font: 700 1.6cqw/1 var(--font-display);
    letter-spacing: 0.1em;
    white-space: nowrap;
    cursor: pointer;
  }

  .screen-actions button:first-child {
    border-color: var(--lb-bone);
    background: var(--lb-bone);
    color: var(--lb-ground);
  }

  .screen-actions > span {
    margin-left: auto;
    color: var(--lb-secondary);
    font-size: 1.5cqw;
    font-weight: 600;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .screen-actions > span b {
    margin-left: 0.8cqw;
    color: var(--lb-bone);
    font-size: 3cqw;
    font-weight: 800;
  }

  .tuner-readout {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 66%;
  }

  .tuner-readout > strong {
    padding: 1cqw 6cqw 1.4cqw;
    background: var(--lb-lamp);
    color: var(--lb-lamp-ink);
    font-size: 10cqw;
    font-weight: 800;
    line-height: 0.9;
  }

  .tuner-readout sup {
    margin-left: 0.6cqw;
    font-size: 4cqw;
  }

  .tuner-readout > span,
  .tuner-readout > small {
    margin-top: 1.4cqw;
    color: var(--lb-secondary);
    font-size: 1.9cqw;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .tuner-rule {
    position: relative;
    width: 68%;
    height: 4cqw;
    margin-top: 1.8cqw;
    border-bottom: 0.2cqw solid var(--lb-rule);
  }

  .tuner-rule::before {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0.3cqw;
    height: 3cqw;
    background: var(--lb-bone);
    content: '';
  }

  .tuner-rule i {
    position: absolute;
    bottom: 0;
    left: 44%;
    width: 0.8cqw;
    height: 4cqw;
    transform: translateX(-50%);
    background: var(--lb-bone);
    transition: left 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .screen-actions--tuner span {
