---
const lessons = [
  {
    title: 'Enter with the sound you want',
    summary: 'Choose a preset first. Looper records that processed rig and locks it for the session.',
    control: 'TOUCH LOOPER',
    alternate: 'or hold the active preset footswitch for 1 second',
    result: 'Track 1 is selected and empty.',
    detail: 'Holding an inactive preset switch only selects it. If the preset has unsaved edits, resolve Save, Discard, or Cancel before Looper opens.',
    states: ['selected empty', 'empty', 'empty', 'empty'],
  },
  {
    title: 'Record the foundation',
    summary: 'Press FS3 once, then play the complete phrase that should repeat.',
    control: 'FS3 · PRESS',
    alternate: 'recording starts at the next processed audio block',
    result: 'The selected track shows REC.',
    detail: 'Your live guitar stays audible while Ardor records the processed stereo output. The first recorded track can be any of the four tracks.',
    states: ['selected rec', 'empty', 'empty', 'empty'],
  },
  {
    title: 'Close the first loop',
    summary: 'Press FS3 again exactly where the phrase should return to its beginning.',
    control: 'FS3 · PRESS',
    alternate: 'the loop closes at the next processed audio block',
    result: 'Playback starts from frame zero.',
    detail: 'This first recording establishes the master length. Every later track follows this length so the layers stay synchronized.',
    states: ['selected play', 'empty', 'empty', 'empty'],
  },
  {
    title: 'Add a synchronized layer',
    summary: 'Press FS2 to select the next track, then press FS3 to arm it.',
    control: 'FS2 · THEN FS3',
    alternate: 'recording waits for the next master-loop boundary',
    result: 'The new track records one complete cycle.',
    detail: 'You do not press FS3 again to stop a later track. Ardor records exactly one master cycle, then changes the track to PLAY automatically.',
    states: ['play', 'selected armed', 'empty', 'empty'],
  },
  {
    title: 'Perform with the layers',
    summary: 'Use FS4 to mute a track and FS1 to undo or restore its latest take.',
    control: 'FS4 · MUTE  /  FS1 · UNDO',
    alternate: 'FS2 continues through tracks 1 to 4 and wraps to 1',
    result: 'All tracks keep the same shared position.',
    detail: 'Muting does not stop a track. Unmuting returns it at the current synchronized phase. On a populated track, FS3 arms a one-cycle overdub.',
    states: ['play', 'selected play', 'play', 'empty'],
  },
  {
    title: 'Pause before managing the session',
    summary: 'Touch STOP ALL. Then Save, Load, New, and Close become available.',
    control: 'TOUCH STOP ALL',
    alternate: 'touch it again to resume from the same position',
    result: 'The playhead stops; live guitar still passes through.',
    detail: 'EXIT also pauses and returns to the preset screen, but leaves the loop session open. CLOSE releases the preset lock.',
    states: ['selected paused', 'paused', 'paused', 'empty'],
  },
  {
    title: 'Tune and return to the same session',
    summary: 'Hold FS1 + FS2 for one second. Ardor pauses the loop and mutes the output for tuning.',
    control: 'FS1 + FS2 · HOLD',
    alternate: 'press any footswitch to leave the tuner',
    result: 'A previously running loop resumes automatically.',
    detail: 'If the loop was already paused, it stays paused when you return. The selected track and recorded audio are unchanged.',
    states: ['selected play', 'play', 'play', 'empty'],
  },
];

const physicalTracks = [0, 2, 1, 3];
---

<section class="looper-guide" id="looper-guide" aria-labelledby="looper-title">
  <header class="looper-intro">
    <div>
      <h2 id="looper-title">Start with one loop.</h2>
      <p>
        Ardor’s Looper holds four synchronized stereo tracks. Your first recording sets the
        length; every later layer lines itself up with that first phrase.
      </p>
    </div>
    <dl>
      <div><dt>First goal</dt><dd>Record one phrase and hear it repeat.</dd></div>
      <div><dt>Working track</dt><dd>The selected track receives FS1, FS3, and FS4 actions.</dd></div>
      <div><dt>Preset lock</dt><dd>Your audible rig stays fixed until the loop session closes.</dd></div>
    </dl>
  </header>

  <div class="looper-walkthrough" data-looper-walkthrough>
    <nav aria-label="Your first loop walkthrough">
      <ol>
        {lessons.map((lesson, index) => (
          <li>
            <button
              type="button"
              class:list={{ active: index === 0 }}
              data-lesson-button={index}
              aria-controls={`looper-lesson-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{lesson.title}</b>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="lesson-field">
      {lessons.map((lesson, index) => (
        <article
          id={`looper-lesson-${index}`}
          data-lesson-panel={index}
          hidden={index !== 0}
          aria-live={index === 0 ? 'polite' : undefined}
        >
          <div class="lesson-copy">
            <span>STEP {index + 1} OF {lessons.length}</span>
            <h3>{lesson.title}</h3>
            <p>{lesson.summary}</p>
            <div class="lesson-command">
              <strong>{lesson.control}</strong>
              <small>{lesson.alternate}</small>
            </div>
            <p class="lesson-result"><b>What happens:</b> {lesson.result}</p>
            <p class="lesson-detail">{lesson.detail}</p>
          </div>

          <div class="looper-screen-study" aria-label={`Looper screen state after step ${index + 1}`}>
            <header><b>LOOPER</b><span>DRIVE STACK · PRESET LOCKED</span></header>
            <div class="study-tracks">
              {physicalTracks.map((trackIndex) => {
                const state = lesson.states[trackIndex];
                const words = state.split(' ');
                const label = words.at(-1)?.toUpperCase();
                return (
                  <div class:list={words} data-state={label?.toLowerCase()}>
                    <small>TRACK {trackIndex + 1}</small>
                    <strong>{label}</strong>
                    <i aria-hidden="true"></i>
                  </div>
                );
              })}
            </div>
            <footer>
              <span>FS1 UNDO</span><span>FS3 REC / DUB</span>
              <span>FS2 TRACK / CLEAR</span><span>FS4 PLAY / MUTE</span>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="practice-rail">
    <div>
      <h3>Practice it on the pedal above.</h3>
      <p>Open the simulator in Looper mode, then use the physical switches instead of advancing this guide.</p>
    </div>
    <button type="button" data-open-looper-simulator>OPEN LOOPER SIMULATOR</button>
  </div>

  <section class="looper-principles" aria-labelledby="timing-title">
    <div class="principle-lead">
      <h2 id="timing-title">The first loop is the clock.</h2>
      <p>
        Ardor does not use a tempo grid or stretch later recordings. It uses the first loop’s
        exact length and waits for its boundary before starting another track or overdub.
      </p>
    </div>
    <div class="loop-timeline" aria-label="How later tracks align to the master loop">
      <div class="timeline-labels"><span>MASTER LOOP</span><span>NEXT WRAP</span><span>ONE COMPLETE CYCLE</span></div>
      <div class="master-rule"><i></i><i></i><i></i></div>
      <div class="armed-rule"><b>FS3</b><span>ARMED</span><i></i><strong>RECORD</strong></div>
      <p>Pressing FS3 while armed cancels the arm. Once recording begins, it completes the full cycle automatically.</p>
    </div>
  </section>

  <section class="switch-manual" aria-labelledby="switch-title">
    <header>
      <h2 id="switch-title">Four switches. Fixed roles.</h2>
      <p>The legends never move when you select another track, so the same foot always performs the same kind of action.</p>
    </header>
    <div class="switch-rows">
      <article>
        <strong>FS1</strong><h3>Undo / redo</h3>
        <p>Toggles the selected track’s latest take. It does nothing while that track is empty, armed, or recording.</p>
      </article>
      <article>
        <strong>FS2</strong><h3>Track / clear</h3>
        <p>Press to select the next track. Hold 1.5 seconds to clear it; releasing during the countdown cancels the clear.</p>
      </article>
      <article>
        <strong>FS3</strong><h3>Record / overdub</h3>
        <p>Starts and closes the first loop. Later, it arms a new track or a one-cycle overdub at the next master wrap.</p>
      </article>
      <article>
        <strong>FS4</strong><h3>Play / mute</h3>
        <p>Mutes or unmutes the selected track while its shared playhead keeps moving.</p>
      </article>
    </div>
  </section>

  <section class="session-actions" aria-labelledby="session-title">
    <header>
      <h2 id="session-title">Leave without surprises.</h2>
      <p>Pause first when you want to manage files or release the preset.</p>
    </header>
    <dl>
      <div><dt>STOP ALL</dt><dd>Pauses every loop track at the shared position. Live guitar continues through the locked preset.</dd></div>
      <div><dt>EXIT</dt><dd>Pauses and returns to the preset screen, but keeps the session open so you can resume it.</dd></div>
      <div><dt>SAVE</dt><dd>Stores the four effective tracks, mix settings, loop length, and a snapshot of the source preset. Available while paused.</dd></div>
      <div><dt>CLOSE</dt><dd>Releases the preset lock and discards only the in-memory session. Saved loop sets remain on disk.</dd></div>
    </dl>
  </section>

  <section class="troubleshooting" aria-labelledby="trouble-title">
    <header>
      <h2 id="trouble-title">When it feels like nothing happened.</h2>
      <p>Most Looper pauses are deliberate synchronization or safety states.</p>
    </header>
    <div>
      <details>
        <summary>My new track says ARMED.</summary>
        <p>It is waiting for the first loop to wrap. Recording begins at that boundary and runs for exactly one complete cycle.</p>
      </details>
      <details>
        <summary>FS3 does nothing during an overdub.</summary>
        <p>The overdub must finish its full cycle. The display reports <strong>OVERDUB ENDS AT LOOP</strong>. After it finishes, use FS1 if you want to undo the take.</p>
      </details>
      <details>
        <summary>Save, Load, New, or Close is unavailable.</summary>
        <p>Touch <strong>STOP ALL</strong> first. Ardor will not silently pause a performance to perform a session-management action.</p>
      </details>
      <details>
        <summary>I cannot change presets.</summary>
        <p>An open loop session owns the preset lock, even while paused. Resume the session or close it to release the lock.</p>
      </details>
      <details>
        <summary>FS2 did not clear my track.</summary>
        <p>Keep holding for the full 1.5-second countdown. Releasing early cancels the clear. Clearing the final populated track also removes the master length.</p>
      </details>
      <details>
        <summary>My very short first loop disappeared.</summary>
        <p>A recording shorter than two configured audio blocks is treated as an accidental tap and discarded.</p>
      </details>
    </div>
  </section>

  <aside class="signal-note">
    <h2>What the Looper records</h2>
    <p>
      Each track captures Ardor’s processed stereo output before master volume and the safety limiter.
      Turning the encoder later changes listening level; it does not rewrite the recorded track.
    </p>
  </aside>
</section>

<style>
  .looper-guide {
    --lg-ground: #141719;
    --lg-recess: #191c1f;
    --lg-plate: #212528;
    --lg-raised: #2a2f33;
    --lg-rule: #3b4247;
    --lg-rule-strong: #687178;
    --lg-text: #e2e4e3;
    --lg-muted: #8d9499;
    --lg-off: #697278;
    --lg-live: #d8422f;
    --lg-warn: #c9973f;
    background: var(--lg-ground);
    color: var(--lg-text);
    border-top: 1px solid var(--lg-rule);
  }

  .looper-intro,
  .looper-walkthrough,
  .practice-rail,
  .looper-principles,
  .switch-manual,
  .session-actions,
  .troubleshooting,
  .signal-note {
    width: min(100% - 3rem, 1240px);
    margin-inline: auto;
  }

  .looper-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding-block: 7rem 4rem;
  }

  .looper-intro h2,
  .principle-lead h2,
  .switch-manual > header h2,
  .session-actions > header h2,
  .troubleshooting > header h2,
  .signal-note h2 {
    color: var(--lg-text);
    font-size: var(--step-4);
  }

  .looper-intro > div > p,
  .principle-lead > p,
  .switch-manual > header p,
  .session-actions > header p,
  .troubleshooting > header p,
  .signal-note p {
    max-width: 60ch;
    color: var(--lg-muted);
    font-size: var(--step-1);
    line-height: 1.48;
  }

  .looper-intro dl,
  .session-actions dl {
    margin: 0;
    border-top: 1px solid var(--lg-rule-strong);
  }

  .looper-intro dl > div,
  .session-actions dl > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--lg-rule);
  }

  .looper-intro dt,
  .session-actions dt {
    color: var(--lg-text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .looper-intro dd,
  .session-actions dd {
    margin: 0;
    color: var(--lg-muted);
    line-height: 1.45;
  }

  .looper-walkthrough {
    display: grid;
    grid-template-columns: minmax(18rem, 0.34fr) minmax(0, 0.66fr);
    min-height: 42rem;
    border-top: 1px solid var(--lg-rule-strong);
    border-bottom: 1px solid var(--lg-rule-strong);
  }

  .looper-walkthrough nav {
    border-right: 1px solid var(--lg-rule);
  }

  .looper-walkthrough ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .looper-walkthrough li + li {
    border-top: 1px solid var(--lg-rule);
  }

  .looper-walkthrough nav button {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
    min-height: 5.85rem;
    padding: 1.25rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--lg-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .looper-walkthrough nav button:hover,
  .looper-walkthrough nav button.active {
    background: var(--lg-plate);
    color: var(--lg-text);
  }

  .looper-walkthrough nav button.active {
    box-shadow: inset 0 -3px var(--lg-live);
  }

  .looper-walkthrough nav span,
  .lesson-copy > span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .looper-walkthrough nav b {
    font-family: var(--font-condensed);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .lesson-field,
  .lesson-field article {
    min-width: 0;
    min-height: 100%;
  }

  .lesson-field article {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .lesson-field article[hidden] {
    display: none;
  }

  .lesson-copy {
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .lesson-copy > span {
    color: var(--lg-muted);
  }

  .lesson-copy h3 {
    max-width: 18ch;
    margin-top: 1rem;
    color: var(--lg-text);
    font-size: var(--step-3);
  }

  .lesson-copy > p {
    max-width: 62ch;
    color: var(--lg-muted);
  }

  .lesson-command {
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) minmax(0, 0.55fr);
    gap: 1.5rem;
    align-items: center;
    margin-block: 2rem 1.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--lg-rule-strong);
    border-bottom: 1px solid var(--lg-rule);
  }

  .lesson-command strong {
    color: var(--lg-live);
    font-family: var(--font-condensed);
    font-size: var(--step-2);
    letter-spacing: 0.06em;
  }

  .lesson-command small {
    color: var(--lg-muted);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .lesson-result b {
    color: var(--lg-text);
  }

  .lesson-detail {
    font-size: 0.9rem;
  }

  .looper-screen-study {
    align-self: end;
    width: min(90%, 42rem);
    margin: 0 auto 3rem;
    border: 0.65rem solid #111416;
    background: var(--lg-plate);
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.28);
  }

  .looper-screen-study > header {
    display: flex;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--lg-rule);
    color: var(--lg-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.11em;
  }

  .looper-screen-study > header b {
    color: var(--lg-text);
  }

  .study-tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    padding: 0.9rem;
  }

  .study-tracks > div {
    position: relative;
    display: flex;
    justify-content: space-between;
    min-height: 5rem;
    padding: 0.9rem;
    border: 1px solid var(--lg-rule);
    background: var(--lg-raised);
  }

  .study-tracks > div.selected {
    border-color: var(--lg-text);
  }

  .study-tracks small {
    color: var(--lg-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
  }

  .study-tracks strong {
    font-family: var(--font-condensed);
    font-size: 1.25rem;
    letter-spacing: 0.08em;
  }

  .study-tracks i {
    position: absolute;
    right: 0.9rem;
    bottom: 0.8rem;
    left: 0.9rem;
    height: 0.25rem;
    background: var(--lg-rule);
  }

  .study-tracks > div.play i,
  .study-tracks > div.paused i {
    background: var(--lg-text);
  }

  .study-tracks > div.rec {
    border-color: var(--lg-live);
  }

  .study-tracks > div.rec strong,
  .study-tracks > div.rec small {
    color: var(--lg-live);
  }

  .study-tracks > div.rec i {
    background: var(--lg-live);
  }

  .study-tracks > div.armed {
    border-color: var(--lg-warn);
  }

  .study-tracks > div.armed strong {
    color: var(--lg-warn);
  }

  .study-tracks > div.empty strong,
  .study-tracks > div.empty small {
    color: var(--lg-off);
  }

  .looper-screen-study footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem 1rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--lg-rule);
    color: var(--lg-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .practice-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--lg-rule-strong);
  }

  .practice-rail h3 {
    margin-bottom: 0.4rem;
    color: var(--lg-text);
    font-size: var(--step-2);
  }

  .practice-rail p {
    margin: 0;
    color: var(--lg-muted);
  }

  .practice-rail button {
    flex: none;
    min-height: 3.25rem;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--lg-text);
    border-radius: 0;
    background: var(--lg-text);
    color: var(--lg-ground);
    font: 600 0.9rem/1 var(--font-condensed);
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .practice-rail button:hover {
    border-color: var(--lg-live);
    background: var(--lg-live);
    color: var(--lg-text);
  }

  .looper-principles,
  .switch-manual,
  .session-actions,
  .troubleshooting {
    display: grid;
    grid-template-columns: minmax(18rem, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: 7rem;
    border-bottom: 1px solid var(--lg-rule);
  }

  .principle-lead h2,
  .switch-manual > header h2,
  .session-actions > header h2,
  .troubleshooting > header h2 {
    font-size: var(--step-3);
  }

  .principle-lead > p,
  .switch-manual > header p,
  .session-actions > header p,
  .troubleshooting > header p {
    font-size: var(--step-0);
  }

  .loop-timeline {
    align-self: center;
  }

  .timeline-labels {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    color: var(--lg-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
  }

  .timeline-labels span:nth-child(2) { color: var(--lg-text); }
  .timeline-labels span:last-child { text-align: right; }

  .master-rule {
    position: relative;
    height: 2.5rem;
    margin-top: 0.65rem;
    border-top: 1px solid var(--lg-rule-strong);
  }

  .master-rule i {
    position: absolute;
    top: -0.5rem;
    width: 1px;
    height: 1rem;
    background: var(--lg-text);
  }

  .master-rule i:first-child { left: 0; }
  .master-rule i:nth-child(2) { left: 50%; }
  .master-rule i:last-child { right: 0; }

  .armed-rule {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 4rem;
    padding: 0 1rem;
    background: var(--lg-plate);
  }

  .armed-rule b,
  .armed-rule span,
  .armed-rule strong {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
  }

  .armed-rule b { color: var(--lg-warn); }
  .armed-rule span { color: var(--lg-muted); }
  .armed-rule strong { color: var(--lg-live); }
  .armed-rule i { height: 1px; background: var(--lg-rule-strong); }

  .loop-timeline > p {
    margin: 1rem 0 0;
    color: var(--lg-muted);
    font-size: 0.9rem;
  }

  .switch-rows,
  .session-actions dl,
  .troubleshooting > div {
    border-top: 1px solid var(--lg-rule-strong);
  }

  .switch-rows article {
    display: grid;
    grid-template-columns: 4rem minmax(10rem, 0.34fr) minmax(0, 0.66fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--lg-rule);
  }

  .switch-rows article > strong {
    color: var(--lg-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
  }

  .switch-rows h3 {
    margin: 0;
    color: var(--lg-text);
    font-size: 1.2rem;
  }

  .switch-rows p {
    margin: 0;
    color: var(--lg-muted);
  }

  .session-actions dl {
    grid-column: 2;
  }

  .session-actions dl > div {
    grid-template-columns: 7rem 1fr;
