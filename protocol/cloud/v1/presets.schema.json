{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ardor.local/protocol/cloud/v1/presets.schema.json",
  "title": "Ardor Cloud Preset Operations v1",
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "slot"],
      "properties": {
        "bank": { "type": "integer", "minimum": 0, "maximum": 99 },
        "slot": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "result"],
      "properties": {
        "ok": { "const": true },
        "result": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
