  (text "ARDOR REV C INTEGRATED DA7212 AUDIO + CONTROL HAT"
    (at 102.65749999999997 173.7 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid b5a6b2f4-982c-442e-9e9f-8cd59628c899)
  )
  (text "Rev C — onboard 24-bit codec, fail-safe outputs, protected guitar/line/amp, isolated MIDI, expression ADC"
    (at 102.65749999999997 181.95 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 581644cd-7fc3-4ec6-a647-8836cdcba156)
  )
  (text "1. POWER / REFERENCE / CHASSIS"
    (at 102.65749999999997 193.95 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 2e1248d4-7b8b-4efe-a7a4-bfec0b6545aa)
  )
  (text "2. HIGH-Z GUITAR INPUT → ONBOARD DA7212"
    (at 102.65749999999997 250.95 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 1ec1e760-f232-4d9f-b405-bbfc8b12059a)
  )
  (text "3. ONBOARD DA7212 → STEREO LINE + MONO GUITAR AMP"
    (at 375.65749999999997 250.95 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 39b5d3ac-cd7c-4057-9ab9-927d178da0e5)
  )
  (text "4. GALVANICALLY ISOLATED TRS MIDI INPUT"
    (at 102.65749999999997 341.4 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 2cfc697b-2ad1-4dac-8766-3c0b4a2e2cf1)
  )
  (text "5. PROTECTED PASSIVE EXPRESSION PEDAL INPUT"
    (at 294.65749999999997 341.4 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 04a5cdce-7cce-4b23-9ea0-f959a77ae248)
  )
  (text "6. FAIL-SAFE OUTPUT MUTE"
    (at 498.65749999999997 341.4 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 81d2ac95-d860-4a4e-bc1f-943a179ed634)
  )
  (text "7. INTEGRATED DA7212 CODEC / I2S / CLOCK / 1.8 V"
    (at 651.6575 193.95 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 04ecc651-d56f-4ba4-8e5b-8918106c880e)
  )
  (text "DA7212: 12.288 MHz master clock, 1.8 V analogue rail, 3.3 V I/O; VDD_SP and microphone paths unused."
    (at 654.6574999999999 294.9 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid bedd399d-be1e-4aa4-af70-887c7ad76c2a)
  )
  (text "GPIO10 HIGH closes K1/K2 only after codec clocks and bias are stable; GPIO10 defaults LOW at reset."
    (at 495.65749999999997 382.65 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid d3d8b44c-d045-4f97-9852-e4dfb09620dd)
  )
  (text "Use isolated-bushing audio jacks. Bond CHASSIS at J9; fit R31 only after hum/EMC verification."
    (at 102.65749999999997 407.4 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid d929acef-5c45-4ba8-9ee1-c43c345fab78)
  )
  (text "U1 is one OPA4377AIPWR in TSSOP-14; place 100nF directly at pins 4 and 11."
    (at 102.65749999999997 414.15 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 21c48b77-a735-4c42-b66f-12e9d45d516d)
  )
  (text "MIDI cable side is isolated: never join MIDI_TIP/RING/SHIELD to AGND/DGND. No extra I2C pull-ups fitted."
    (at 102.65749999999997 420.9 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 2851dca0-6dd6-4987-a735-336f3f6fbde4)
  )
  (text "Rev C J2/J3 are DNI bring-up headers. DA7212 input divider provides active-pickup headroom; compensate in codec gain."
    (at 102.65749999999997 427.65 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid c056449d-f937-4ab9-9704-03a3155f18ec)
  )
