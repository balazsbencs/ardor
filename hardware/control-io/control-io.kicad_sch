  (text "MIDI IN: 3.5 mm TRS Type A, galvanically isolated"
    (at 63.74249999999999 30.9375 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 7b20510a-430e-4511-8a2d-80160a9a3793)
  )
  (text "EXPRESSION: passive 6.35 mm TRS pedal, hardware polarity selector, ADS1115"
