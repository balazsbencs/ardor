        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid c35563a9-a571-4212-94bb-29655525cfd7)
  )
  (text "R4 limits a shorted pedal cable to 3.3 mA. D2/D3: BAT54 Schottky clamps."
