  (text "1. POWER / REFERENCE / CHASSIS"
    (at 72.90000000000003 106.95000000000002 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 7de40ed2-54fe-4637-a1c2-1ffce91a6056)
  )
  (text "2. HIGH-Z GUITAR INPUT → CODEC ZERO AUX IN"
    (at 72.90000000000003 163.95000000000002 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid c61b9458-cf09-4df7-8d62-4611a34381ce)
  )
  (text "3. CODEC ZERO AUX OUT → STEREO LINE + MONO GUITAR AMP"
    (at 345.90000000000003 163.95000000000002 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid f7ce7a99-7911-4f5a-aaa2-acb345b42fce)
  )
  (text "4. GALVANICALLY ISOLATED TRS MIDI INPUT"
    (at 72.90000000000003 254.40000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid eb3f1827-3224-44f9-8426-d2ad215bf1d7)
  )
  (text "5. PROTECTED PASSIVE EXPRESSION PEDAL INPUT"
    (at 264.90000000000003 254.40000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 089080f7-146b-44e6-b8b1-7b57feafdc1a)
  )
  (text "6. FAIL-SAFE OUTPUT MUTE"
    (at 468.90000000000003 254.40000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 8ba2552b-639a-4a60-8a0f-772eec90ce49)
  )
  (text "GPIO10 HIGH closes K1/K2 only after codec clocks and bias are stable; GPIO10 defaults LOW at reset."
    (at 465.90000000000003 295.65 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 51750693-58b3-47a3-9137-8e515e040e58)
  )
  (text "Use isolated-bushing audio jacks. Bond CHASSIS at J9; fit R31 only after hum/EMC verification."
    (at 72.90000000000003 320.40000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 8fdcc465-3524-4454-b508-4e1a33299386)
  )
  (text "U1 is one OPA4377AIPWR in TSSOP-14; place 100nF directly at pins 4 and 11."
    (at 72.90000000000003 327.15000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid a6e66099-bc36-497e-a3bd-d1246c1c5419)
  )
  (text "MIDI cable side is isolated: never join MIDI_TIP/RING/SHIELD to AGND/DGND. No extra I2C pull-ups fitted."
    (at 72.90000000000003 333.9 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid 836745ec-5d12-4421-ad55-7b39da5d8b3e)
  )
  (text "Codec P1/P2 pin order (square pin 1): LEFT, GND, RIGHT, GND. AUX maximum: 1 V RMS."
    (at 72.90000000000003 340.65000000000003 0)
    (effects
      (font
        (size 1.27 1.27)
        (color 0 0 0 1)
      )
    )
    (uuid a308f5ed-4995-4608-a2e8-232e5272d213)
  )
