        (color 0 0 0 1)
      )
    )
    (uuid a32cb1e0-decf-48bb-88e8-6fe77ddfba21)
  )
  (text "SW1A/SW1B are the two mechanically linked poles of one DPDT switch."
    (at 177.7425 154.3875 0)
    (effects
