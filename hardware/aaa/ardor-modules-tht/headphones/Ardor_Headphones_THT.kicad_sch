rd timer. Check DC/transients, oscillation, noise and clipping on dummy loads." (at 25.4 276.2 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "5fd4c739-9b2b-522f-a96e-8fd71d9676b7"))(text "PIN GUIDE: IN = into this board / OUT = out / I/O = both / GND = 0 V" (at 190 16 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "15289d6a-2f0f-59e6-ba71-c65bb00bf2e0"))(text "J101 / PWR + ENABLE IN" (at 190 20 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "afbc2806-d5b4-5fb4-aaa6-c9925ae6511a"))(text "1: 5V IN   2: GND 0V" (at 190 22.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "1dd602a2-802a-5a68-b320-79b154c9a3b1"))(text "3: ENABLE IN" (at 190 23.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b4c99ad2-5304-5031-87c8-b595d02b28fa"))(text "J102 / AUDIO IN" (at 300 20 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b39d2e6e-3751-5631-bd02-7b720a8c061f"))(text "1: LEFT IN   2: GND 0V" (at 300 22.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "d5db0943-675f-5385-a170-1050bf766a1d"))(text "3: RIGHT IN" (at 300 23.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "4ed662fa-761e-5431-b0a7-cc9df765dd61"))(text "J602 / HEADPHONE OUT" (at 190 29 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "84ddfc05-3a90-523a-8e96-4c3774bebd51"))(text "1: LEFT OUT   2: RIGHT OUT" (at 190 31.0 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "8fe5ed8c-0ff8-53f0-9914-6ce79de12990"))(text "3: GND 0V" (at 190 32.8 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "6388bb3f-9578-5bbf-be22-ed3a3e5b7cf8"))(label "GND" (at 35.56 66.04 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "5ede048f-fc35-5f54-9b6a-db214e4bd7a0"))(label "+5V" (at 35.56 208.28 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "6a8592b8-3b48-51b8-a7ca-63e7b106e4d6"))(label "GND" (at 35.56 205.74 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "a4fdd405-0a07-5531-b8ef-5a71