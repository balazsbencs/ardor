      (pins R202-2 U201-4 R203-1)
    )
    (net "unconnected-(U201-Pad3)"
      (pins U201-3)
    )
    (class kicad_default /+3V3 /+5V /CHASSIS /GND /MIDI_4 /MIDI_5 "Net-(D201-A)"
      "Net-(D201-K)" "Net-(FB201-Pad2)" "Net-(J101-Pin_4)" "Net-(R202-Pad2)"
      "unconnected-(U201-Pad3)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
