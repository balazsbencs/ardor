stify left)) (uuid "9676ddf6-7ef9-499b-8805-03a042634119") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 321.31 213.36 0) (effects (font (size 1 1)) (hide yes))))(text "HPVDD is an INTERNAL regulator output. Never connect it to +5V_A. HPVSS is negative; use nonpolar ceramic.\nG0=0, G1=0 gives -6 dB inverting gain. INL+ / INR+ grounded per TI single-ended application.\n32 ohm or higher stereo headphones. 1 Vrms AUX gives ~0.47 Vrms at 32 ohm (~6.8 mW); start volume low.\nKeep EN low until codec routing is stable; ramp volume. Short, separate SGND jack return to local ground plane.\nPlace pump capacitors at pins; keep switching loops away from AUX, VREF and expression input traces." (at 20 250 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "a6b56e12-60ba-4694-ade5-0d9ab1994b57"))(symbol (lib_id "Ardor:Conn_01x03") (at 345.44 180.34 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "83039c48-6b65-4cf0-bd6a-277de6686e6c") (property "Reference" "J602" (at 345.44 166.34 0) (effects (font (size 1.15 1.15))))(property "Value" "TO HP PANEL / T,R,S" (at 345.44 169.34 0) (effects (font (size 1.15 1.15))))(property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 345.44 180.34 0) (effects (font (size 1.15 1.15)) (hide yes)))(property "Datasheet" "" (at 345.44 180.34 0) (effects (font (size 1.15 1.15)) (hide yes)))(property "MPN" "" (at 345.44 180.34 0) (effects (font (size 1.15 1.15)) (hide yes))) (pin "1" (uuid "7a2e76d7-9f08-4560-8fcd-aaabf78e6cd7"))(pin "2" (uuid "fdedaf1b-f7ff-4ae6-8ed5-3506d1e9a106"))(pin "3" (uuid "cec1ff0f-f01e-43ad-ac0e-04e949052003"))(instances (project "Ardor_IO" (path "/4e737327-a0ea-4a6f-94e1-a9e1e5e3775c/60900772-43cf-4568-8928-7b6de116f7f8" (reference "J602") (unit 1)))))(global_label "HP_L" (shape passive) (at 335.28 177.8 180) (effects (font (size 1.1 1.1)) (justify right)) (uuid "ee841edf-46db-4d75-a950-9a5430a0d273") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 335.28 177.8 180) (effec