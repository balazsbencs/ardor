#!/bin/sh

PID=/var/run/ardor-pedal.pid
ENV=/etc/ardor-pedal.env
RELAY_ENABLE=/sys/class/leds/ardor:audio-output-enable/brightness

[ -r "$ENV" ] && . "$ENV"

: "${DATA_ROOT:=/opt/ardor-pedal}"
: "${BANK:=0}"
: "${SLOT:=0}"
: "${SAMPLE_RATE:=48000}"
: "${BLOCK_SIZE:=64}"
: "${IR_SAMPLES:=8192}"
: "${CAPTURE_DEVICE:=-1}"
: "${PLAYBACK_DEVICE:=-1}"
: "${INPUT_CHANNEL:=0}"
: "${OUTPUT_CHANNEL:=both}"
: "${PARALLEL_RIGS:=${DUAL_AMP_PARALLEL:-1}}"
: "${AUDIO_CPU:=2}"
: "${RIG_WORKER_CPU:=${DUAL_AMP_WORKER_CPU:-3}}"
: "${TELEMETRY_FILE:=/run/ardor-pedal.telemetry}"
: "${CONTROL_DEVICES:=}"
: "${MIDI_DEVICE:=}"
: "${MIDI_CHANNEL:=omni}"
: "${MIDI_TUNER_CC:=20}"
: "${EXPRESSION_DEVICE:=}"
: "${EXPRESSION_MIN_RAW:=0}"
: "${EXPRESSION_MAX_RAW:=26400}"
: "${EXPRESSION_SMOOTHING:=0.25}"
: "${EXPRESSION_DEADBAND:=0.002}"
: "${UI:=1}"
: "${ARDOR_SYSTEM_ROOT:=/opt/ardor-pedal/system}"

PEDAL_BIN=/usr/bin/ardor-pedal
if [ -x "$ARDOR_SYSTEM_ROOT/current/bin/ardor-pedal" ]; then
  PEDAL_BIN="$ARDOR_SYSTEM_ROOT/current/bin/ardor-pedal"
fi

set_output_relay() {
  [ -w "$RELAY_ENABLE" ] || return 1
  echo "$1" > "$RELAY_ENABLE"
}

control_args=""
for dev in $CONTROL_DEVICES; do
  control_args="$control_args --control-device $dev"
done
ui_arg=""
[ "$UI" = "1" ] && ui_arg="--ui"
parallel_rig_args=""
[ "$PARALLEL_RIGS" = "1" ] && \
  parallel_rig_args="--parallel-rigs --audio-cpu $AUDIO_CPU --rig-worker-cpu $RIG_WORKER_CPU"
telemetry_args=""
[ -n "$TELEMETRY_FILE" ] && telemetry_args="--telemetry-file $TELEMETRY_FILE"
midi_args=""
[ -n "$MIDI_DEVICE" ] && \
  midi_args="--midi-device $MIDI_DEVICE --midi-channel $MIDI_CHANNEL --midi-tuner-cc $MIDI_TUNER_CC"
expression_args=""
[ -n "$EXPRESSION_DEVICE" ] && \
  expression_args="--expression-device $EXPRESSION_DEVICE --expression-min-raw $EXPRESSION_MIN_RAW --expression-max-raw $EXPRESSION_MAX_RAW --expression-smoothing $EXPRESSION_SMOOTHING --expression-deadband $EXPRESSION_DEADBAND"

# The data partition is seeded once, when the image is built. A pedal that
# keeps its presets across an update therefore never receives circuit tables
# added after it was flashed, and every block that reads one reports a missing
# asset. Copy anything the root filesystem carries that the data root lacks.
seed_missing_assets() {
  src=/usr/share/ardor-pedal/assets
  [ -d "$src" ] || return 0
  find "$src" -type f | while read -r file; do
    target="$DATA_ROOT/assets/${file#"$src"/}"
    [ -f "$target" ] && continue
    mkdir -p "$(dirname "$target")"
    cp "$file" "$target"
  done
}

run_supervised() {
  # Silence the framebuffer console so it stops drawing over the LVGL UI.
  # Do NOT unbind vtcon: dropping fbcon releases the DRM pipe and freezes
  # the DSI panel on a decaying last frame. Muting printk and the cursor
  # keeps the pipe alive while nothing overdraws the UI after boot.
  if [ "$UI" = "1" ]; then
    dmesg -n 1
    echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
  fi

  # Mute -> route -> start -> unmute: no boot pop, and a crash-looping
  # app never plays half-initialized audio at full volume.
  set_output_relay 0 || echo "Audio-output relay control is unavailable; outputs remain hardware-muted" >&2
  trap 'set_output_relay 0; amixer -q set '\''Headphone'\'' mute 2>/dev/null' EXIT INT TERM
  amixer -q set 'Headphone' mute 2>/dev/null
  alsactl restore -f /etc/ardor-codec-zero.state 2>/dev/null
  for policy in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$policy" ] && echo performance > "$policy"
  done
  while :; do
    # The touchscreen stores its audio choice in the global settings document.
    # Re-read it for every supervised launch so a clean child exit can apply a
    # new period without restarting the supervisor shell itself.
    current_block_size="$BLOCK_SIZE"
    if [ -r "$DATA_ROOT/settings/global.json" ]; then
      saved_block_size=$(sed -n 's/^[[:space:]]*"audioBlockSize"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "$DATA_ROOT/settings/global.json" | head -n 1)
      case "$saved_block_size" in
        32|64|128) current_block_size="$saved_block_size" ;;
      esac
    fi
    "$PEDAL_BIN" \
      --realtime $ui_arg \
      --data-root "$DATA_ROOT" \
      --bank "$BANK" \
      --slot "$SLOT" \
      --sample-rate "$SAMPLE_RATE" \
      --block-size "$current_block_size" \
      --ir-samples "$IR_SAMPLES" \
      --capture-device "$CAPTURE_DEVICE" \
      --playback-device "$PLAYBACK_DEVICE" \
      --input-channel "$INPUT_CHANNEL" \
      --output-channel "$OUTPUT_CHANNEL" \
      $parallel_rig_args \
      $telemetry_args \
      $midi_args \
      $expression_args \
      $control_args &
    APP=$!
    sleep 1
    amixer -q set 'Headphone' unmute 2>/dev/null
    if ! set_output_relay 1; then
      echo "Refusing hardware unmute: $RELAY_ENABLE is unavailable" >&2
    fi
    wait $APP
    app_status=$?
    set_output_relay 0
    echo "ardor-pedal exited ($app_status), respawning" >&2
    amixer -q set 'Headphone' mute 2>/dev/null
    sleep 1
  done
}

case "$1" in
  start)
    echo "Starting ardor-pedal"
    start-stop-daemon -S -b -m -p "$PID" --exec /bin/sh -- "$0" run
    ;;
  run)
    seed_missing_assets
    run_supervised
    ;;
  stop)
    echo "Stopping ardor-pedal"
    set_output_relay 0
    start-stop-daemon -K -p "$PID"
    killall ardor-pedal 2>/dev/null
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac
