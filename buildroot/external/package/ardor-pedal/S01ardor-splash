#!/bin/sh

LEGACY_PID=/var/run/ardor-splash.pid
BIN=/usr/bin/ardor-splash

case "$1" in
  start)
    [ -x "$BIN" ] || exit 0
    [ -e /dev/fb0 ] || {
      i=0
      while [ "$i" -lt 100 ] && [ ! -e /dev/fb0 ]; do
        sleep 0.05
        i=$((i + 1))
      done
    }
    [ -e /dev/fb0 ] || exit 0
    "$BIN" /dev/fb0 /usr/share/ardor-pedal/ardor-splash.rgb565
    ;;
  stop)
    # Terminate a painter left by the earlier continuously animated
    # implementation during an in-place LAN upgrade. The current renderer is
    # one-shot and has already exited after leaving its frame behind.
    killall ardor-splash 2>/dev/null || true
    rm -f "$LEGACY_PID"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
