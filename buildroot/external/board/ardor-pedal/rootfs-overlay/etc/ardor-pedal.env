DATA_ROOT=/opt/ardor-pedal
BANK=0
SLOT=0
SAMPLE_RATE=48000
BLOCK_SIZE=64
IR_SAMPLES=8192
CAPTURE_DEVICE=-1
PLAYBACK_DEVICE=-1
INPUT_CHANNEL=0
OUTPUT_CHANNEL=both
PARALLEL_RIGS=1
AUDIO_CPU=2
RIG_WORKER_CPU=3
TELEMETRY_FILE=/run/ardor-pedal.telemetry
CONTROL_DEVICES="/dev/input/event0 /dev/input/event1"
UI=1
